<UserControl x:Class="TuTiendita.ClientesUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="👥 Gestión de Clientes - CRM" FontSize="24" FontWeight="Bold"/>
            <TextBlock Text="Administra tus clientes, créditos y descuentos especiales"
                       FontSize="13" Foreground="#7F8C8D" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Search and Actions -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Search Box -->
            <Border Grid.Column="0" Background="White" BorderBrush="#BDC3C7" BorderThickness="1"
                    CornerRadius="5" Padding="10" Margin="0,0,10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🔍" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="txtBuscar" Grid.Column="1" BorderThickness="0"
                             VerticalAlignment="Center" FontSize="14"
                             TextChanged="TxtBuscar_TextChanged">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <VisualBrush Stretch="None" AlignmentX="Left">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="Buscar cliente por nombre, documento o teléfono..."
                                                                   Foreground="#95A5A6" FontSize="14"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>
            </Border>

            <!-- Action Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="btnNuevoCliente" Content="➕ Nuevo Cliente" Width="140" Height="40"
                        Background="#27AE60" Foreground="White" FontWeight="Bold" BorderThickness="0"
                        Margin="0,0,10,0" Click="BtnNuevoCliente_Click" Cursor="Hand"/>
                <Button x:Name="btnActualizar" Content="🔄 Actualizar" Width="120" Height="40"
                        Background="#3498DB" Foreground="White" FontWeight="Bold" BorderThickness="0"
                        Click="BtnActualizar_Click" Cursor="Hand"/>
            </StackPanel>
        </Grid>

        <!-- Customers DataGrid -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="10">
            <DataGrid x:Name="dgClientes" AutoGenerateColumns="False"
                      IsReadOnly="True" SelectionMode="Single"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      RowHeight="45" AlternatingRowBackground="#F8F9FA"
                      SelectionChanged="DgClientes_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                    <DataGridTextColumn Header="Nombre Completo" Binding="{Binding NombreCompleto}" Width="180"/>
                    <DataGridTextColumn Header="Documento" Binding="{Binding Documento}" Width="120"/>
                    <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="120"/>
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="180"/>
                    <DataGridTextColumn Header="Compras" Binding="{Binding TotalCompras}" Width="80">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="#3498DB"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Total Gastado" Binding="{Binding TotalGastadoFormateado}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Right"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="#27AE60"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Deuda Actual" Binding="{Binding DeudaTotalFormateada}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Right"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="#E74C3C"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Límite Crédito" Binding="{Binding LimiteCreditoFormateado}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Descuento" Binding="{Binding DescuentoFormateado}" Width="90">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="#9B59B6"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="Acciones" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="✏️ Editar" Width="80" Height="30" Margin="5,0"
                                            Background="#3498DB" Foreground="White" FontSize="11"
                                            BorderThickness="0" Click="BtnEditar_Click" Cursor="Hand"
                                            Tag="{Binding Id}"/>
                                    <Button Content="💳 Crédito" Width="80" Height="30" Margin="5,0"
                                            Background="#9B59B6" Foreground="White" FontSize="11"
                                            BorderThickness="0" Click="BtnCredito_Click" Cursor="Hand"
                                            Tag="{Binding Id}"/>
                                    <Button Content="🗑️ Eliminar" Width="80" Height="30" Margin="5,0"
                                            Background="#E74C3C" Foreground="White" FontSize="11"
                                            BorderThickness="0" Click="BtnEliminar_Click" Cursor="Hand"
                                            Tag="{Binding Id}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
