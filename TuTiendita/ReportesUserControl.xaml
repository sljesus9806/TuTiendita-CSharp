<UserControl x:Class="TuTiendita.ReportesUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Background="#34495E" Padding="20">
            <TextBlock Text="Reportes y Estadísticas" FontSize="24" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="Análisis de ventas, inventario y usuarios" FontSize="14" Foreground="#ECF0F1" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Content -->
        <TabControl Grid.Row="1" Margin="0" BorderThickness="0">
            <!-- Sales Report Tab -->
            <TabItem Header="Reporte de Ventas" FontSize="14" Padding="10">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Filter Section -->
                    <Border Grid.Row="0" BorderBrush="#BDC3C7" BorderThickness="1" Padding="15" Margin="0,0,0,15" CornerRadius="5">
                        <StackPanel>
                            <TextBlock Text="Filtros" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Desde:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <DatePicker Grid.Column="1" x:Name="dpFechaDesde" Margin="0,0,20,0"/>

                                <TextBlock Grid.Column="2" Text="Hasta:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <DatePicker Grid.Column="3" x:Name="dpFechaHasta" Margin="0,0,20,0"/>

                                <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="btnHoy" Content="Hoy" Width="80" Height="30"
                                            Margin="0,0,10,0" Click="BtnHoy_Click" Cursor="Hand"/>
                                    <Button x:Name="btnSemana" Content="Esta Semana" Width="100" Height="30"
                                            Margin="0,0,10,0" Click="BtnSemana_Click" Cursor="Hand"/>
                                    <Button x:Name="btnMes" Content="Este Mes" Width="80" Height="30"
                                            Margin="0,0,10,0" Click="BtnMes_Click" Cursor="Hand"/>
                                    <Button x:Name="btnBuscarVentas" Content="Buscar" Width="100" Height="30"
                                            Background="#3498DB" Foreground="White" BorderThickness="0"
                                            Click="BtnBuscarVentas_Click" Cursor="Hand"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Summary Cards -->
                    <Grid Grid.Row="1" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#3498DB" Padding="15" Margin="0,0,10,0" CornerRadius="5">
                            <StackPanel>
                                <TextBlock Text="Total Ventas" FontSize="12" Foreground="White" Opacity="0.9"/>
                                <TextBlock x:Name="txtTotalVentas" Text="$0.00" FontSize="24" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="#2ECC71" Padding="15" Margin="0,0,10,0" CornerRadius="5">
                            <StackPanel>
                                <TextBlock Text="Núm. Transacciones" FontSize="12" Foreground="White" Opacity="0.9"/>
                                <TextBlock x:Name="txtNumTransacciones" Text="0" FontSize="24" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#E67E22" Padding="15" Margin="0,0,10,0" CornerRadius="5">
                            <StackPanel>
                                <TextBlock Text="Venta Promedio" FontSize="12" Foreground="White" Opacity="0.9"/>
                                <TextBlock x:Name="txtVentaPromedio" Text="$0.00" FontSize="24" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3" Background="#9B59B6" Padding="15" CornerRadius="5">
                            <StackPanel>
                                <TextBlock Text="Productos Vendidos" FontSize="12" Foreground="White" Opacity="0.9"/>
                                <TextBlock x:Name="txtProductosVendidos" Text="0" FontSize="24" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Sales List -->
                    <Border Grid.Row="2" BorderBrush="#BDC3C7" BorderThickness="1" Padding="15" CornerRadius="5">
                        <StackPanel>
                            <TextBlock Text="Detalle de Ventas" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                            <DataGrid x:Name="dgVentas" AutoGenerateColumns="False" IsReadOnly="True"
                                      GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                      AlternatingRowBackground="#F8F9FA" RowHeight="35"
                                      SelectionChanged="DgVentas_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                                    <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="150"/>
                                    <DataGridTextColumn Header="Usuario" Binding="{Binding UsuarioNombre}" Width="120"/>
                                    <DataGridTextColumn Header="Total" Binding="{Binding TotalFormateado}" Width="100"/>
                                    <DataGridTextColumn Header="Pagado" Binding="{Binding MontoPagadoFormateado}" Width="100"/>
                                    <DataGridTextColumn Header="Cambio" Binding="{Binding CambioFormateado}" Width="100"/>
                                    <DataGridTextColumn Header="Turno" Binding="{Binding TurnoId}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Sale Details Tab -->
            <TabItem Header="Detalle de Venta" FontSize="14" Padding="10">
                <Grid Margin="20">
                    <StackPanel>
                        <TextBlock Text="Seleccione una venta en la pestaña 'Reporte de Ventas' para ver el detalle"
                                   x:Name="txtNoSeleccion" FontSize="14" Foreground="#95A5A6"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,50,0,0"/>

                        <Border x:Name="pnlDetalleVenta" Visibility="Collapsed" BorderBrush="#BDC3C7"
                                BorderThickness="1" Padding="20" CornerRadius="5">
                            <StackPanel>
                                <TextBlock Text="Información de la Venta" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Venta #:" FontWeight="SemiBold" Margin="0,5,15,5"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="txtDetalleVentaId" Text="" Margin="0,5"/>

                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Fecha:" FontWeight="SemiBold" Margin="20,5,15,5"/>
                                    <TextBlock Grid.Row="0" Grid.Column="3" x:Name="txtDetalleFecha" Text="" Margin="0,5"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Usuario:" FontWeight="SemiBold" Margin="0,5,15,5"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtDetalleUsuario" Text="" Margin="0,5"/>

                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Total:" FontWeight="SemiBold" Margin="20,5,15,5"/>
                                    <TextBlock Grid.Row="1" Grid.Column="3" x:Name="txtDetalleTotal" Text="" Margin="0,5" FontWeight="Bold"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Pagado:" FontWeight="SemiBold" Margin="0,5,15,5"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="txtDetallePagado" Text="" Margin="0,5"/>

                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Cambio:" FontWeight="SemiBold" Margin="20,5,15,5"/>
                                    <TextBlock Grid.Row="2" Grid.Column="3" x:Name="txtDetalleCambio" Text="" Margin="0,5"/>
                                </Grid>

                                <TextBlock Text="Productos Vendidos" FontSize="16" FontWeight="Bold" Margin="0,10,0,10"/>
                                <DataGrid x:Name="dgDetalleVenta" AutoGenerateColumns="False" IsReadOnly="True"
                                          GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                          AlternatingRowBackground="#F8F9FA" RowHeight="35">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Código" Binding="{Binding ProductoCodigo}" Width="100"/>
                                        <DataGridTextColumn Header="Producto" Binding="{Binding ProductoNombre}" Width="*"/>
                                        <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="80"/>
                                        <DataGridTextColumn Header="Precio Unit." Binding="{Binding PrecioUnitarioFormateado}" Width="120"/>
                                        <DataGridTextColumn Header="Subtotal" Binding="{Binding SubtotalFormateado}" Width="120"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Inventory Report Tab -->
            <TabItem Header="Reporte de Inventario" FontSize="14" Padding="10">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Summary -->
                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#16A085" Padding="15" Margin="0,0,10,0" CornerRadius="5">
                            <StackPanel>
                                <TextBlock Text="Total Productos" FontSize="12" Foreground="White" Opacity="0.9"/>
                                <TextBlock x:Name="txtTotalProductos" Text="0" FontSize="24" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="#D35400" Padding="15" Margin="0,0,10,0" CornerRadius="5">
                            <StackPanel>
                                <TextBlock Text="Productos Bajo Stock" FontSize="12" Foreground="White" Opacity="0.9"/>
                                <TextBlock x:Name="txtProductosBajoStock" Text="0" FontSize="24" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#8E44AD" Padding="15" CornerRadius="5">
                            <StackPanel>
                                <TextBlock Text="Valor Total Inventario" FontSize="12" Foreground="White" Opacity="0.9"/>
                                <TextBlock x:Name="txtValorInventario" Text="$0.00" FontSize="24" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Inventory List -->
                    <Border Grid.Row="1" BorderBrush="#BDC3C7" BorderThickness="1" Padding="15" CornerRadius="5">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                <TextBlock Text="Inventario de Productos" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Button x:Name="btnActualizarInventario" Content="Actualizar" Width="100" Height="30"
                                        Margin="20,0,0,0" Click="BtnActualizarInventario_Click" Cursor="Hand"/>
                            </StackPanel>
                            <DataGrid x:Name="dgInventario" AutoGenerateColumns="False" IsReadOnly="True"
                                      GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                      AlternatingRowBackground="#F8F9FA" RowHeight="35">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="100"/>
                                    <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                                    <DataGridTextColumn Header="Precio" Binding="{Binding PrecioFormateado}" Width="120"/>
                                    <DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="100"/>
                                    <DataGridTextColumn Header="Valor Total" Binding="{Binding ValorTotalFormateado}" Width="150"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
