<Window x:Class="TuTiendita.VentanaRegistrarPago"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registrar Pago" Height="500" Width="550"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="💵 Registrar Pago de Crédito" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="Registre el abono del cliente a su cuenta de crédito" FontSize="13" Foreground="#7F8C8D" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Form -->
        <StackPanel Grid.Row="1">
            <!-- Información del Crédito -->
            <Border Background="#ECF0F1" CornerRadius="5" Padding="15" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="📋 Información del Crédito" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Crédito #:" FontWeight="Bold" Margin="0,0,10,5"/>
                        <TextBlock x:Name="txtCreditoId" Grid.Row="0" Grid.Column="1" Margin="0,0,0,5"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Monto Total:" FontWeight="Bold" Margin="0,0,10,5"/>
                        <TextBlock x:Name="txtMontoTotal" Grid.Row="1" Grid.Column="1" Margin="0,0,0,5"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Abonado:" FontWeight="Bold" Margin="0,0,10,5"/>
                        <TextBlock x:Name="txtMontoAbonado" Grid.Row="2" Grid.Column="1" Foreground="#27AE60" Margin="0,0,0,5"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Pendiente:" FontWeight="Bold" Margin="0,0,10,5"/>
                        <TextBlock x:Name="txtMontoPendiente" Grid.Row="3" Grid.Column="1" Foreground="#E74C3C" FontWeight="Bold" FontSize="16"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Datos del Pago -->
            <TextBlock Text="💰 Datos del Pago" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

            <StackPanel Margin="0,0,0,15">
                <TextBlock Text="Monto a Abonar ($) *" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtMonto" Height="40" FontSize="16" Padding="10"
                         TextChanged="TxtMonto_TextChanged"/>
                <TextBlock x:Name="txtAviso" Text="" FontSize="11" Foreground="#E74C3C" Margin="0,5,0,0"/>
            </StackPanel>

            <StackPanel Margin="0,0,0,15">
                <TextBlock Text="Método de Pago *" FontWeight="Bold" Margin="0,0,0,5"/>
                <ComboBox x:Name="cmbMetodoPago" Height="40" FontSize="14" Padding="10">
                    <ComboBoxItem Content="Efectivo" IsSelected="True"/>
                    <ComboBoxItem Content="Tarjeta"/>
                    <ComboBoxItem Content="Transferencia"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Margin="0,0,0,15">
                <TextBlock Text="Notas" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtNotas" Height="70" FontSize="14" Padding="8"
                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
            </StackPanel>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="btnGuardar" Content="💾 Registrar Pago" Width="150" Height="40"
                    Background="#27AE60" Foreground="White" FontWeight="Bold" BorderThickness="0"
                    Margin="0,0,10,0" Click="BtnGuardar_Click" Cursor="Hand"/>
            <Button x:Name="btnCancelar" Content="❌ Cancelar" Width="120" Height="40"
                    Background="#95A5A6" Foreground="White" FontWeight="Bold" BorderThickness="0"
                    Click="BtnCancelar_Click" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
