<Window x:Class="TuTiendita.VentanaEditarCliente"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar Cliente"
        MinHeight="600" MinWidth="500"
        Height="680" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#F5F5F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#16A085" Padding="20,15">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock x:Name="txtTitulo" Text="NUEVO CLIENTE" FontSize="20" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="Complete la informacion del cliente" FontSize="12"
                           Foreground="#A3E4D7" HorizontalAlignment="Center" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20,15,20,0">
            <StackPanel>
                <!-- Información Personal -->
                <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="INFORMACION PERSONAL" FontSize="14" FontWeight="Bold"
                                   Foreground="#16A085" Margin="0,0,0,15"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="NOMBRE *" FontSize="11" FontWeight="Bold" Foreground="#666" Margin="0,0,0,5"/>
                                <Border Background="#FAFAFA" CornerRadius="6" BorderBrush="#DDD" BorderThickness="1">
                                    <TextBox x:Name="txtNombre" Height="38" FontSize="14" Padding="10,0"
                                             BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="APELLIDO" FontSize="11" FontWeight="Bold" Foreground="#666" Margin="0,0,0,5"/>
                                <Border Background="#FAFAFA" CornerRadius="6" BorderBrush="#DDD" BorderThickness="1">
                                    <TextBox x:Name="txtApellido" Height="38" FontSize="14" Padding="10,0"
                                             BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="DOCUMENTO (CURP/RFC)" FontSize="11" FontWeight="Bold" Foreground="#666" Margin="0,0,0,5"/>
                            <Border Background="#FAFAFA" CornerRadius="6" BorderBrush="#DDD" BorderThickness="1">
                                <TextBox x:Name="txtDocumento" Height="38" FontSize="14" Padding="10,0"
                                         BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="FECHA DE NACIMIENTO" FontSize="11" FontWeight="Bold" Foreground="#666" Margin="0,0,0,5"/>
                            <Border Background="#FAFAFA" CornerRadius="6" BorderBrush="#DDD" BorderThickness="1">
                                <DatePicker x:Name="dpFechaNacimiento" Height="38" FontSize="14"
                                            BorderThickness="0" Background="Transparent"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Información de Contacto -->
                <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="INFORMACION DE CONTACTO" FontSize="14" FontWeight="Bold"
                                   Foreground="#16A085" Margin="0,0,0,15"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="TELEFONO" FontSize="11" FontWeight="Bold" Foreground="#666" Margin="0,0,0,5"/>
                                <Border Background="#FAFAFA" CornerRadius="6" BorderBrush="#DDD" BorderThickness="1">
                                    <TextBox x:Name="txtTelefono" Height="38" FontSize="14" Padding="10,0"
                                             BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="EMAIL" FontSize="11" FontWeight="Bold" Foreground="#666" Margin="0,0,0,5"/>
                                <Border Background="#FAFAFA" CornerRadius="6" BorderBrush="#DDD" BorderThickness="1">
                                    <TextBox x:Name="txtEmail" Height="38" FontSize="14" Padding="10,0"
                                             BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <StackPanel>
                            <TextBlock Text="DIRECCION" FontSize="11" FontWeight="Bold" Foreground="#666" Margin="0,0,0,5"/>
                            <Border Background="#FAFAFA" CornerRadius="6" BorderBrush="#DDD" BorderThickness="1">
                                <TextBox x:Name="txtDireccion" Height="38" FontSize="14" Padding="10,0"
                                         BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Configuración Comercial -->
                <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="CONFIGURACION COMERCIAL" FontSize="14" FontWeight="Bold"
                                   Foreground="#16A085" Margin="0,0,0,15"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="LIMITE DE CREDITO ($)" FontSize="11" FontWeight="Bold" Foreground="#666" Margin="0,0,0,5"/>
                                <Border Background="#FAFAFA" CornerRadius="6" BorderBrush="#16A085" BorderThickness="2">
                                    <Grid>
                                        <TextBox x:Name="txtLimiteCredito" Text="0" Height="38" FontSize="14" Padding="30,0,10,0"
                                                 BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"/>
                                        <TextBlock Text="$" FontSize="14" FontWeight="Bold" Foreground="#16A085"
                                                   VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="DESCUENTO ESPECIAL (%)" FontSize="11" FontWeight="Bold" Foreground="#666" Margin="0,0,0,5"/>
                                <Border Background="#FAFAFA" CornerRadius="6" BorderBrush="#DDD" BorderThickness="1">
                                    <Grid>
                                        <TextBox x:Name="txtDescuentoEspecial" Text="0" Height="38" FontSize="14" Padding="10,0,30,0"
                                                 BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"/>
                                        <TextBlock Text="%" FontSize="14" FontWeight="Bold" Foreground="#666"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" IsHitTestVisible="False"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <StackPanel>
                            <TextBlock Text="NOTAS" FontSize="11" FontWeight="Bold" Foreground="#666" Margin="0,0,0,5"/>
                            <Border Background="#FAFAFA" CornerRadius="6" BorderBrush="#DDD" BorderThickness="1">
                                <TextBox x:Name="txtNotas" Height="70" FontSize="13" Padding="10"
                                         BorderThickness="0" Background="Transparent"
                                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <Grid Grid.Row="2" Margin="20,15,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="btnCancelar" Grid.Column="0" Content="Cancelar" Height="48" Margin="0,0,5,0"
                    Click="BtnCancelar_Click" Background="#E0E0E0" Foreground="#333"
                    BorderThickness="0" FontSize="15" Cursor="Hand" IsCancel="True">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>

            <Button x:Name="btnGuardar" Grid.Column="1" Content="Guardar Cliente" Height="48" Margin="5,0,0,0"
                    Click="BtnGuardar_Click" Background="#16A085" Foreground="White"
                    FontWeight="Bold" BorderThickness="0" FontSize="15" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Grid>
</Window>
