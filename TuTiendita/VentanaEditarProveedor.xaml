<Window x:Class="TuTiendita.VentanaEditarProveedor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar Proveedor" Height="550" Width="600"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock x:Name="txtTitulo" Text="Nuevo Proveedor" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="Complete la información del proveedor" FontSize="13" Foreground="#7F8C8D" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Información Básica -->
                <TextBlock Text="📋 Información Básica" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="Nombre de la Empresa *" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtNombre" Height="35" FontSize="14" Padding="8"/>
                </StackPanel>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="RFC" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtRUC" Height="35" FontSize="14" Padding="8"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Persona de Contacto" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtContacto" Height="35" FontSize="14" Padding="8"/>
                    </StackPanel>
                </Grid>

                <!-- Información de Contacto -->
                <TextBlock Text="📞 Información de Contacto" FontSize="16" FontWeight="Bold" Margin="0,20,0,15"/>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Teléfono" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtTelefono" Height="35" FontSize="14" Padding="8"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Email" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtEmail" Height="35" FontSize="14" Padding="8"/>
                    </StackPanel>
                </Grid>

                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="Dirección" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtDireccion" Height="35" FontSize="14" Padding="8"/>
                </StackPanel>

                <!-- Notas -->
                <TextBlock Text="📝 Notas Adicionales" FontSize="16" FontWeight="Bold" Margin="0,20,0,15"/>

                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="Notas (términos de pago, condiciones, etc.)" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtNotas" Height="80" FontSize="14" Padding="8"
                             TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="btnGuardar" Content="💾 Guardar" Width="120" Height="40"
                    Background="#27AE60" Foreground="White" FontWeight="Bold" BorderThickness="0"
                    Margin="0,0,10,0" Click="BtnGuardar_Click" Cursor="Hand"/>
            <Button x:Name="btnCancelar" Content="❌ Cancelar" Width="120" Height="40"
                    Background="#95A5A6" Foreground="White" FontWeight="Bold" BorderThickness="0"
                    Click="BtnCancelar_Click" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
