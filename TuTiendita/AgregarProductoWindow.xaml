<Window x:Class="TuTiendita.AgregarProductoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agregar Producto" Height="420" Width="450"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Label Content="Código:" Grid.Row="0" VerticalAlignment="Center"/>
        <TextBox x:Name="txtCodigo" Grid.Row="0" Margin="120,0,0,10"/>

        <Label Content="Nombre:" Grid.Row="1" VerticalAlignment="Center"/>
        <TextBox x:Name="txtNombre" Grid.Row="1" Margin="120,0,0,10"/>

        <Label Content="Categoría:" Grid.Row="2" VerticalAlignment="Center"/>
        <ComboBox x:Name="cmbCategoria" Grid.Row="2" Margin="120,0,0,10" DisplayMemberPath="Nombre" SelectedValuePath="Id"/>

        <Label Content="Precio de Venta:" Grid.Row="3" VerticalAlignment="Center"/>
        <TextBox x:Name="txtPrecio" Grid.Row="3" Margin="120,0,0,10"/>

        <Label Content="Costo:" Grid.Row="4" VerticalAlignment="Center"/>
        <TextBox x:Name="txtCosto" Grid.Row="4" Margin="120,0,0,10" Text="0"/>

        <Label Content="Stock Inicial:" Grid.Row="5" VerticalAlignment="Center"/>
        <TextBox x:Name="txtStock" Grid.Row="5" Margin="120,0,0,10"/>

        <Label Content="Stock Mínimo:" Grid.Row="6" VerticalAlignment="Center"/>
        <TextBox x:Name="txtStockMinimo" Grid.Row="6" Margin="120,0,0,10" Text="5"/>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Guardar" Width="90" Margin="5" Click="BtnGuardar_Click" Background="#27AE60" Foreground="White" FontWeight="Bold"/>
            <Button Content="Cancelar" Width="90" Margin="5" Click="BtnCancelar_Click"/>
        </StackPanel>
    </Grid>
</Window>
