<Window x:Class="TuTiendita.AgregarProductoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agregar Nuevo Producto" Height="520" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5">
    <Grid>
        <!-- Header -->
        <Border Background="#3498DB" Height="60" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                <TextBlock Text="📦" FontSize="28" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Agregar Nuevo Producto" FontSize="20" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Complete los datos del producto" FontSize="12" Foreground="#BDE0FE"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Form Content -->
        <Border Margin="20,80,20,20" Background="White" CornerRadius="8"
                BorderBrush="#E0E0E0" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
            </Border.Effect>
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Código de Barras -->
                <StackPanel Grid.Row="0" Margin="0,0,0,15">
                    <TextBlock Text="Código de Barras / SKU" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,5"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtCodigo" Grid.Column="0" Height="38" FontSize="14" Padding="10,8"
                                 BorderBrush="#DDD" BorderThickness="1"
                                 ToolTip="Escanee el código de barras o ingrese manualmente"
                                 KeyDown="TxtCodigo_KeyDown"/>
                        <Button x:Name="btnGenerarCodigo" Grid.Column="1" Content="Auto" Width="50" Height="38" Margin="5,0,0,0"
                                Background="#95A5A6" Foreground="White" FontWeight="Bold" BorderThickness="0"
                                Click="BtnGenerarCodigo_Click" Cursor="Hand"
                                ToolTip="Generar código automático"/>
                    </Grid>
                    <TextBlock Text="💡 Escanee con lector o presione 'Auto' para generar" FontSize="11" Foreground="#888" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Nombre del Producto -->
                <StackPanel Grid.Row="1" Margin="0,0,0,15">
                    <TextBlock Text="Nombre del Producto *" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtNombre" Height="38" FontSize="14" Padding="10,8"
                             BorderBrush="#DDD" BorderThickness="1"/>
                </StackPanel>

                <!-- Categoría -->
                <StackPanel Grid.Row="2" Margin="0,0,0,15">
                    <TextBlock Text="Categoría" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,5"/>
                    <ComboBox x:Name="cmbCategoria" Height="38" FontSize="14" Padding="10,8"
                              DisplayMemberPath="Nombre" SelectedValuePath="Id"
                              BorderBrush="#DDD" BorderThickness="1"/>
                </StackPanel>

                <!-- Precios -->
                <Grid Grid.Row="3" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Precio de Venta *" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,5"/>
                        <Grid>
                            <TextBox x:Name="txtPrecio" Height="38" FontSize="14" Padding="35,8,10,8"
                                     BorderBrush="#DDD" BorderThickness="1"/>
                            <TextBlock Text="$" FontSize="14" FontWeight="Bold" Foreground="#666"
                                       VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Costo" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,5"/>
                        <Grid>
                            <TextBox x:Name="txtCosto" Height="38" FontSize="14" Padding="35,8,10,8"
                                     BorderBrush="#DDD" BorderThickness="1" Text="0"/>
                            <TextBlock Text="$" FontSize="14" FontWeight="Bold" Foreground="#666"
                                       VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- Stock -->
                <Grid Grid.Row="4" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Stock Inicial *" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtStock" Height="38" FontSize="14" Padding="10,8"
                                 BorderBrush="#DDD" BorderThickness="1"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Stock Mínimo" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtStockMinimo" Height="38" FontSize="14" Padding="10,8"
                                 BorderBrush="#DDD" BorderThickness="1" Text="5"/>
                    </StackPanel>
                </Grid>

                <!-- Margen calculado -->
                <Border Grid.Row="5" Background="#F8F9FA" CornerRadius="5" Padding="10" Margin="0,0,0,15">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📊 Margen de ganancia: " FontSize="12" Foreground="#666"/>
                        <TextBlock x:Name="txtMargen" Text="--" FontSize="12" FontWeight="Bold" Foreground="#27AE60"/>
                    </StackPanel>
                </Border>

                <!-- Botones -->
                <Grid Grid.Row="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="1" Content="Cancelar" Width="100" Height="40" Margin="0,0,10,0"
                            Click="BtnCancelar_Click" Background="#E0E0E0" Foreground="#333"
                            BorderThickness="0" FontSize="14" Cursor="Hand"/>
                    <Button Grid.Column="2" Content="Guardar" Width="120" Height="40"
                            Click="BtnGuardar_Click" Background="#27AE60" Foreground="White"
                            FontWeight="Bold" BorderThickness="0" FontSize="14" Cursor="Hand"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
