<Window x:Class="TuTiendita.AgregarProductoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agregar Nuevo Producto"
        MinHeight="550" MinWidth="450"
        SizeToContent="Height" Width="500"
        MaxHeight="750"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#F5F5F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#3498DB" Padding="20,15">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="NUEVO PRODUCTO" FontSize="20" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="Complete los datos del producto" FontSize="12"
                           Foreground="#AED6F1" HorizontalAlignment="Center" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Content con ScrollViewer -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="25,20,25,25">
                <!-- Código de Barras -->
                <TextBlock Text="CODIGO DE BARRAS / SKU" FontSize="12" FontWeight="Bold"
                           Foreground="#666" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="White" CornerRadius="6"
                            BorderBrush="#DDD" BorderThickness="1">
                        <TextBox x:Name="txtCodigo" Height="42" FontSize="14" Padding="12,0"
                                 BorderThickness="0" Background="Transparent"
                                 VerticalContentAlignment="Center"
                                 KeyDown="TxtCodigo_KeyDown"/>
                    </Border>
                    <Button x:Name="btnGenerarCodigo" Grid.Column="1" Content="Auto" Width="60" Height="42" Margin="8,0,0,0"
                            Background="#95A5A6" Foreground="White" FontWeight="Bold" BorderThickness="0"
                            Click="BtnGenerarCodigo_Click" Cursor="Hand"
                            ToolTip="Generar codigo automatico">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
                <TextBlock Text="Escanee con lector o presione 'Auto' para generar" FontSize="11"
                           Foreground="#888" Margin="0,0,0,15"/>

                <!-- Nombre del Producto -->
                <TextBlock Text="NOMBRE DEL PRODUCTO *" FontSize="12" FontWeight="Bold"
                           Foreground="#666" Margin="0,0,0,8"/>
                <Border Background="White" CornerRadius="6" BorderBrush="#DDD"
                        BorderThickness="1" Margin="0,0,0,15">
                    <TextBox x:Name="txtNombre" Height="42" FontSize="14" Padding="12,0"
                             BorderThickness="0" Background="Transparent"
                             VerticalContentAlignment="Center"/>
                </Border>

                <!-- Categoría -->
                <TextBlock Text="CATEGORIA" FontSize="12" FontWeight="Bold"
                           Foreground="#666" Margin="0,0,0,8"/>
                <Border Background="White" CornerRadius="6" BorderBrush="#DDD"
                        BorderThickness="1" Margin="0,0,0,15">
                    <ComboBox x:Name="cmbCategoria" Height="42" FontSize="14" Padding="12,0"
                              DisplayMemberPath="Nombre" SelectedValuePath="Id"
                              BorderThickness="0" Background="Transparent"/>
                </Border>

                <!-- Precios -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="PRECIO DE VENTA *" FontSize="12" FontWeight="Bold"
                                   Foreground="#666" Margin="0,0,0,8"/>
                        <Border Background="White" CornerRadius="6" BorderBrush="#3498DB"
                                BorderThickness="2">
                            <Grid>
                                <TextBox x:Name="txtPrecio" Height="42" FontSize="16" FontWeight="SemiBold"
                                         Padding="35,0,12,0" BorderThickness="0" Background="Transparent"
                                         VerticalContentAlignment="Center"/>
                                <TextBlock Text="$" FontSize="16" FontWeight="Bold" Foreground="#3498DB"
                                           VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="COSTO" FontSize="12" FontWeight="Bold"
                                   Foreground="#666" Margin="0,0,0,8"/>
                        <Border Background="White" CornerRadius="6" BorderBrush="#DDD"
                                BorderThickness="1">
                            <Grid>
                                <TextBox x:Name="txtCosto" Height="42" FontSize="14" Padding="35,0,12,0"
                                         BorderThickness="0" Background="Transparent" Text="0"
                                         VerticalContentAlignment="Center"/>
                                <TextBlock Text="$" FontSize="14" FontWeight="Bold" Foreground="#666"
                                           VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Stock -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="STOCK INICIAL *" FontSize="12" FontWeight="Bold"
                                   Foreground="#666" Margin="0,0,0,8"/>
                        <Border Background="White" CornerRadius="6" BorderBrush="#DDD"
                                BorderThickness="1">
                            <TextBox x:Name="txtStock" Height="42" FontSize="14" Padding="12,0"
                                     BorderThickness="0" Background="Transparent"
                                     VerticalContentAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="STOCK MINIMO" FontSize="12" FontWeight="Bold"
                                   Foreground="#666" Margin="0,0,0,8"/>
                        <Border Background="White" CornerRadius="6" BorderBrush="#DDD"
                                BorderThickness="1">
                            <TextBox x:Name="txtStockMinimo" Height="42" FontSize="14" Padding="12,0"
                                     BorderThickness="0" Background="Transparent" Text="5"
                                     VerticalContentAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Margen calculado -->
                <Border Background="#E8F8F5" CornerRadius="8" Padding="15" Margin="0,0,0,20"
                        BorderBrush="#27AE60" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="Margen de ganancia: " FontSize="13" Foreground="#666"/>
                        <TextBlock x:Name="txtMargen" Text="--" FontSize="13" FontWeight="Bold" Foreground="#27AE60"/>
                    </StackPanel>
                </Border>

                <!-- Botones -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="Cancelar" Height="48" Margin="0,0,5,0"
                            Click="BtnCancelar_Click" Background="#E0E0E0" Foreground="#333"
                            BorderThickness="0" FontSize="15" Cursor="Hand" IsCancel="True">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Grid.Column="1" Content="Guardar Producto" Height="48" Margin="5,0,0,0"
                            Click="BtnGuardar_Click" Background="#3498DB" Foreground="White"
                            FontWeight="Bold" BorderThickness="0" FontSize="15" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
