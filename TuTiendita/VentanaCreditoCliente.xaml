<Window x:Class="TuTiendita.VentanaCreditoCliente"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestión de Crédito" Height="700" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock x:Name="txtTitulo" Text="💳 Gestión de Crédito" FontSize="22" FontWeight="Bold"/>
            <TextBlock x:Name="txtCliente" FontSize="14" Foreground="#7F8C8D" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Credit Summary Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Límite de Crédito -->
            <Border Grid.Column="0" Background="#3498DB" CornerRadius="10" Padding="15" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="💰 Límite de Crédito" FontSize="12" Foreground="White" Opacity="0.9"/>
                    <TextBlock x:Name="txtLimiteCredito" Text="$0.00" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- Deuda Actual -->
            <Border Grid.Column="1" Background="#E74C3C" CornerRadius="10" Padding="15" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="📊 Deuda Actual" FontSize="12" Foreground="White" Opacity="0.9"/>
                    <TextBlock x:Name="txtDeudaActual" Text="$0.00" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- Crédito Disponible -->
            <Border Grid.Column="2" Background="#27AE60" CornerRadius="10" Padding="15">
                <StackPanel>
                    <TextBlock Text="✅ Crédito Disponible" FontSize="12" Foreground="White" Opacity="0.9"/>
                    <TextBlock x:Name="txtCreditoDisponible" Text="$0.00" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Tabs -->
        <TabControl Grid.Row="2">
            <!-- Tab: Créditos Activos -->
            <TabItem Header="📋 Créditos Activos">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="dgCreditos" Grid.Row="0" AutoGenerateColumns="False"
                              IsReadOnly="True" SelectionMode="Single"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              RowHeight="40" AlternatingRowBackground="#F8F9FA">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                            <DataGridTextColumn Header="Venta #" Binding="{Binding VentaId}" Width="80"/>
                            <DataGridTextColumn Header="Fecha Venta" Binding="{Binding FechaVentaFormateada}" Width="120"/>
                            <DataGridTextColumn Header="Vencimiento" Binding="{Binding FechaVencimientoFormateada}" Width="120"/>
                            <DataGridTextColumn Header="Monto Total" Binding="{Binding MontoTotalFormateado}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Abonado" Binding="{Binding MontoAbonadoFormateado}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                        <Setter Property="Foreground" Value="#27AE60"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Pendiente" Binding="{Binding MontoPendienteFormateado}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#E74C3C"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Estado" Binding="{Binding EstadoFormateado}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Acciones" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="💵 Abonar" Width="90" Height="28"
                                                Background="#27AE60" Foreground="White" FontSize="11"
                                                BorderThickness="0" Click="BtnAbonar_Click" Cursor="Hand"
                                                Tag="{Binding Id}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button x:Name="btnActualizarCreditos" Grid.Row="1" Content="🔄 Actualizar" Width="120" Height="35"
                            Background="#3498DB" Foreground="White" FontWeight="Bold" BorderThickness="0"
                            Margin="0,10,0,0" HorizontalAlignment="Right"
                            Click="BtnActualizarCreditos_Click" Cursor="Hand"/>
                </Grid>
            </TabItem>

            <!-- Tab: Historial de Pagos -->
            <TabItem Header="💰 Historial de Pagos">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="dgPagos" Grid.Row="0" AutoGenerateColumns="False"
                              IsReadOnly="True" SelectionMode="Single"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              RowHeight="40" AlternatingRowBackground="#F8F9FA">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                            <DataGridTextColumn Header="Crédito #" Binding="{Binding CreditoId}" Width="90"/>
                            <DataGridTextColumn Header="Fecha Pago" Binding="{Binding FechaPagoFormateada}" Width="140"/>
                            <DataGridTextColumn Header="Monto" Binding="{Binding MontoFormateado}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#27AE60"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Método" Binding="{Binding MetodoPago}" Width="120"/>
                            <DataGridTextColumn Header="Notas" Binding="{Binding Notas}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock x:Name="txtTotalPagado" Grid.Row="1" FontSize="16" FontWeight="Bold"
                               Foreground="#27AE60" Margin="0,10,0,0" HorizontalAlignment="Right"/>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Close Button -->
        <Button Grid.Row="3" Content="❌ Cerrar" Width="120" Height="40"
                Background="#95A5A6" Foreground="White" FontWeight="Bold" BorderThickness="0"
                Margin="0,20,0,0" HorizontalAlignment="Right"
                Click="BtnCerrar_Click" Cursor="Hand"/>
    </Grid>
</Window>
