<Window x:Class="TuTiendita.DialogoCierreCaja"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cierre de Caja - Contador de Denominaciones"
        MinHeight="650" MinWidth="550"
        Height="720" Width="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#F5F5F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="20,15">
            <StackPanel>
                <TextBlock Text="CONTADOR DE DENOMINACIONES" FontSize="20" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="Cuente el efectivo en caja para cerrar el turno" FontSize="12"
                           Foreground="#95A5A6" HorizontalAlignment="Center" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Denominaciones -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20,15,20,0">
            <StackPanel>
                <!-- Billetes -->
                <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="BILLETES" FontSize="14" FontWeight="Bold" Foreground="#2C3E50"/>
                            <Border Background="#27AE60" CornerRadius="10" Padding="8,2" Margin="10,0,0,0">
                                <TextBlock x:Name="txtTotalBilletes" Text="$0.00" FontSize="11"
                                           Foreground="White" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="40"/>
                            </Grid.RowDefinitions>

                            <!-- $1000 -->
                            <Border Grid.Row="0" Grid.Column="0" Background="#8E44AD" CornerRadius="4" Margin="0,2" Padding="8,0">
                                <TextBlock Text="$1,000" VerticalAlignment="Center" Foreground="White" FontWeight="Bold"/>
                            </Border>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="txt1000" Text="0" Margin="8,2"
                                     VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                     FontSize="14" FontWeight="SemiBold" TextChanged="Denominacion_Changed"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" x:Name="total1000" Text="$0.00"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Bold" FontSize="14"/>

                            <!-- $500 -->
                            <Border Grid.Row="1" Grid.Column="0" Background="#3498DB" CornerRadius="4" Margin="0,2" Padding="8,0">
                                <TextBlock Text="$500" VerticalAlignment="Center" Foreground="White" FontWeight="Bold"/>
                            </Border>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="txt500" Text="0" Margin="8,2"
                                     VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                     FontSize="14" FontWeight="SemiBold" TextChanged="Denominacion_Changed"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" x:Name="total500" Text="$0.00"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Bold" FontSize="14"/>

                            <!-- $200 -->
                            <Border Grid.Row="2" Grid.Column="0" Background="#27AE60" CornerRadius="4" Margin="0,2" Padding="8,0">
                                <TextBlock Text="$200" VerticalAlignment="Center" Foreground="White" FontWeight="Bold"/>
                            </Border>
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="txt200" Text="0" Margin="8,2"
                                     VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                     FontSize="14" FontWeight="SemiBold" TextChanged="Denominacion_Changed"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" x:Name="total200" Text="$0.00"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Bold" FontSize="14"/>

                            <!-- $100 -->
                            <Border Grid.Row="3" Grid.Column="0" Background="#E74C3C" CornerRadius="4" Margin="0,2" Padding="8,0">
                                <TextBlock Text="$100" VerticalAlignment="Center" Foreground="White" FontWeight="Bold"/>
                            </Border>
                            <TextBox Grid.Row="3" Grid.Column="1" x:Name="txt100" Text="0" Margin="8,2"
                                     VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                     FontSize="14" FontWeight="SemiBold" TextChanged="Denominacion_Changed"/>
                            <TextBlock Grid.Row="3" Grid.Column="2" x:Name="total100" Text="$0.00"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Bold" FontSize="14"/>

                            <!-- $50 -->
                            <Border Grid.Row="4" Grid.Column="0" Background="#F39C12" CornerRadius="4" Margin="0,2" Padding="8,0">
                                <TextBlock Text="$50" VerticalAlignment="Center" Foreground="White" FontWeight="Bold"/>
                            </Border>
                            <TextBox Grid.Row="4" Grid.Column="1" x:Name="txt50" Text="0" Margin="8,2"
                                     VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                     FontSize="14" FontWeight="SemiBold" TextChanged="Denominacion_Changed"/>
                            <TextBlock Grid.Row="4" Grid.Column="2" x:Name="total50" Text="$0.00"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Bold" FontSize="14"/>

                            <!-- $20 -->
                            <Border Grid.Row="5" Grid.Column="0" Background="#1ABC9C" CornerRadius="4" Margin="0,2" Padding="8,0">
                                <TextBlock Text="$20" VerticalAlignment="Center" Foreground="White" FontWeight="Bold"/>
                            </Border>
                            <TextBox Grid.Row="5" Grid.Column="1" x:Name="txt20" Text="0" Margin="8,2"
                                     VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                     FontSize="14" FontWeight="SemiBold" TextChanged="Denominacion_Changed"/>
                            <TextBlock Grid.Row="5" Grid.Column="2" x:Name="total20" Text="$0.00"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Bold" FontSize="14"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Monedas -->
                <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="MONEDAS" FontSize="14" FontWeight="Bold" Foreground="#2C3E50"/>
                            <Border Background="#3498DB" CornerRadius="10" Padding="8,2" Margin="10,0,0,0">
                                <TextBlock x:Name="txtTotalMonedas" Text="$0.00" FontSize="11"
                                           Foreground="White" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="40"/>
                            </Grid.RowDefinitions>

                            <!-- $10 -->
                            <Border Grid.Row="0" Grid.Column="0" Background="#95A5A6" CornerRadius="4" Margin="0,2" Padding="8,0">
                                <TextBlock Text="$10" VerticalAlignment="Center" Foreground="White" FontWeight="Bold"/>
                            </Border>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="txt10" Text="0" Margin="8,2"
                                     VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                     FontSize="14" FontWeight="SemiBold" TextChanged="Denominacion_Changed"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" x:Name="total10" Text="$0.00"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Bold" FontSize="14"/>

                            <!-- $5 -->
                            <Border Grid.Row="1" Grid.Column="0" Background="#7F8C8D" CornerRadius="4" Margin="0,2" Padding="8,0">
                                <TextBlock Text="$5" VerticalAlignment="Center" Foreground="White" FontWeight="Bold"/>
                            </Border>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="txt5" Text="0" Margin="8,2"
                                     VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                     FontSize="14" FontWeight="SemiBold" TextChanged="Denominacion_Changed"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" x:Name="total5" Text="$0.00"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Bold" FontSize="14"/>

                            <!-- $2 -->
                            <Border Grid.Row="2" Grid.Column="0" Background="#BDC3C7" CornerRadius="4" Margin="0,2" Padding="8,0">
                                <TextBlock Text="$2" VerticalAlignment="Center" Foreground="#2C3E50" FontWeight="Bold"/>
                            </Border>
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="txt2" Text="0" Margin="8,2"
                                     VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                     FontSize="14" FontWeight="SemiBold" TextChanged="Denominacion_Changed"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" x:Name="total2" Text="$0.00"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Bold" FontSize="14"/>

                            <!-- $1 -->
                            <Border Grid.Row="3" Grid.Column="0" Background="#ECF0F1" CornerRadius="4" Margin="0,2" Padding="8,0">
                                <TextBlock Text="$1" VerticalAlignment="Center" Foreground="#2C3E50" FontWeight="Bold"/>
                            </Border>
                            <TextBox Grid.Row="3" Grid.Column="1" x:Name="txt1" Text="0" Margin="8,2"
                                     VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                     FontSize="14" FontWeight="SemiBold" TextChanged="Denominacion_Changed"/>
                            <TextBlock Grid.Row="3" Grid.Column="2" x:Name="total1" Text="$0.00"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Bold" FontSize="14"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Notas -->
                <Border Background="White" CornerRadius="8" Padding="15">
                    <StackPanel>
                        <TextBlock Text="NOTAS DEL CIERRE (opcional)" FontSize="14" FontWeight="Bold"
                                   Foreground="#2C3E50" Margin="0,0,0,10"/>
                        <TextBox x:Name="txtNotas" Height="70" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" Padding="10" FontSize="13"
                                 BorderBrush="#DDD" BorderThickness="1"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Total -->
        <Border Grid.Row="2" Background="#27AE60" Padding="20" Margin="20,15,20,0" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="TOTAL EFECTIVO CONTADO:" FontSize="16"
                           FontWeight="Bold" VerticalAlignment="Center" Foreground="White"/>
                <TextBlock Grid.Column="1" x:Name="txtTotalGeneral" Text="$0.00" FontSize="28"
                           FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Botones -->
        <Grid Grid.Row="3" Margin="20,15,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Limpiar Todo" Height="45" Margin="0,0,10,0"
                    Click="BtnLimpiar_Click" Background="#E0E0E0" Foreground="#333"
                    BorderThickness="0" FontSize="14" Cursor="Hand" HorizontalAlignment="Left" Width="120">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>

            <Button Grid.Column="1" Content="Cancelar" Width="120" Height="45" Margin="0,0,10,0"
                    Click="BtnCancelar_Click" Background="#95A5A6" Foreground="White"
                    BorderThickness="0" FontSize="14" Cursor="Hand" IsCancel="True">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>

            <Button Grid.Column="2" Content="Confirmar Cierre" Width="140" Height="45"
                    Click="BtnAceptar_Click" Background="#27AE60" Foreground="White"
                    FontWeight="Bold" BorderThickness="0" FontSize="14" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Grid>
</Window>
