<Window x:Class="TuTiendita.DialogoAdminOverride"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Autenticación de Administrador" Height="300" Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#ECF0F1">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="15" Margin="-20,-20,-20,20" CornerRadius="0">
            <StackPanel>
                <TextBlock Text="🔐 Acceso de Administrador" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="Ingrese credenciales de administrador para continuar" FontSize="11" Foreground="#BDC3C7" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Form -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock Text="⚠️  ADVERTENCIA: Solo administradores pueden acceder a esta función"
                       Background="#E74C3C" Foreground="White" Padding="10" Margin="0,0,0,20"
                       TextWrapping="Wrap" FontSize="11" FontWeight="SemiBold"/>

            <TextBlock Text="Usuario:" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtUsuario" Height="35" VerticalContentAlignment="Center"
                     Padding="10,0" FontSize="14" Margin="0,0,0,15"/>

            <TextBlock Text="Contraseña:" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <PasswordBox x:Name="txtContrasena" Height="35" VerticalContentAlignment="Center"
                        Padding="10,0" FontSize="14" Margin="0,0,0,10"
                        KeyDown="TxtContrasena_KeyDown"/>

            <TextBlock x:Name="txtError" Text="" Foreground="#E74C3C" FontWeight="Bold"
                       Margin="0,5,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Autenticar" Width="120" Height="40" Margin="0,0,10,0"
                    Background="#27AE60" Foreground="White" FontWeight="Bold" FontSize="14"
                    Click="BtnAutenticar_Click" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Cancelar" Width="120" Height="40"
                    Background="#95A5A6" Foreground="White" FontWeight="Bold" FontSize="14"
                    Click="BtnCancelar_Click" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
