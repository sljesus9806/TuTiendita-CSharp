<Window x:Class="TuTiendita.DialogoAdminOverride"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Autenticacion de Administrador"
        MinHeight="320" MinWidth="400"
        SizeToContent="Height" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#E74C3C" Padding="20,15">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="ACCESO RESTRINGIDO" FontSize="20" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="Se requieren credenciales de administrador" FontSize="12"
                           Foreground="#FADBD8" HorizontalAlignment="Center" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <StackPanel Grid.Row="1" Margin="25,20,25,25">
            <!-- Advertencia -->
            <Border Background="#FEF9E7" CornerRadius="8" Padding="12" Margin="0,0,0,20"
                    BorderBrush="#F39C12" BorderThickness="1">
                <TextBlock Text="Solo personal autorizado puede realizar esta accion. El acceso quedara registrado."
                           TextWrapping="Wrap" FontSize="12" Foreground="#7D6608"/>
            </Border>

            <!-- Usuario -->
            <TextBlock Text="USUARIO" FontSize="12" FontWeight="Bold" Foreground="#666" Margin="0,0,0,8"/>
            <Border Background="White" CornerRadius="6" BorderBrush="#DDD" BorderThickness="1" Margin="0,0,0,15">
                <TextBox x:Name="txtUsuario" Height="42" VerticalContentAlignment="Center"
                         Padding="12,0" FontSize="14" BorderThickness="0" Background="Transparent"/>
            </Border>

            <!-- Contraseña -->
            <TextBlock Text="CONTRASENA" FontSize="12" FontWeight="Bold" Foreground="#666" Margin="0,0,0,8"/>
            <Border Background="White" CornerRadius="6" BorderBrush="#DDD" BorderThickness="1" Margin="0,0,0,15">
                <PasswordBox x:Name="txtContrasena" Height="42" VerticalContentAlignment="Center"
                             Padding="12,0" FontSize="14" BorderThickness="0" Background="Transparent"
                             KeyDown="TxtContrasena_KeyDown"/>
            </Border>

            <!-- Error -->
            <TextBlock x:Name="txtError" Text="" Foreground="#E74C3C" FontWeight="Bold"
                       Margin="0,0,0,15" TextWrapping="Wrap" Visibility="Collapsed"/>

            <!-- Botones -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Cancelar" Height="45" Margin="0,0,5,0"
                        Click="BtnCancelar_Click" Background="#E0E0E0" Foreground="#333"
                        BorderThickness="0" FontSize="14" Cursor="Hand" IsCancel="True">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Grid.Column="1" Content="Autenticar" Height="45" Margin="5,0,0,0"
                        Click="BtnAutenticar_Click" Background="#E74C3C" Foreground="White"
                        FontWeight="Bold" BorderThickness="0" FontSize="14" Cursor="Hand" IsDefault="True">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
