<Window x:Class="TuTiendita.DialogoMovimientoCaja"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registrar Movimiento de Caja" Height="350" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tipo de Movimiento -->
        <TextBlock Grid.Row="0" Text="Tipo de Movimiento" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
            <RadioButton x:Name="rbGasto" Content="Gasto" FontSize="13" Margin="0,0,20,0" IsChecked="True" GroupName="TipoMovimiento"/>
            <RadioButton x:Name="rbRetiro" Content="Retiro a Caja Fuerte" FontSize="13" Margin="0,0,20,0" GroupName="TipoMovimiento"/>
            <RadioButton x:Name="rbDeposito" Content="Depósito/Entrada" FontSize="13" GroupName="TipoMovimiento"/>
        </StackPanel>

        <!-- Monto -->
        <Grid Grid.Row="2" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Monto:" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <TextBox Grid.Column="1" x:Name="txtMonto" Height="30" VerticalContentAlignment="Center" FontSize="14"/>
        </Grid>

        <!-- Concepto -->
        <Grid Grid.Row="3" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Concepto:" VerticalAlignment="Top" FontWeight="SemiBold" Margin="0,5,0,0"/>
            <TextBox Grid.Column="1" x:Name="txtConcepto" Height="80" TextWrapping="Wrap"
                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
        </Grid>

        <!-- Ayuda -->
        <Border Grid.Row="4" Background="#ECF0F1" Padding="10" CornerRadius="5" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Ejemplos:" FontWeight="Bold" FontSize="12" Margin="0,0,0,5"/>
                <TextBlock Text="• Gasto: Compra de suministros, pago a proveedor, servicios" FontSize="11" Margin="0,2"/>
                <TextBlock Text="• Retiro: Mover efectivo a caja fuerte por seguridad" FontSize="11" Margin="0,2"/>
                <TextBlock Text="• Depósito: Agregar fondos iniciales, devolución, otros ingresos" FontSize="11" Margin="0,2"/>
            </StackPanel>
        </Border>

        <!-- Botones -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Guardar" Width="100" Height="35" Margin="5" Click="BtnGuardar_Click"
                    Background="#27AE60" Foreground="White" FontWeight="Bold"/>
            <Button Content="Cancelar" Width="100" Height="35" Margin="5" Click="BtnCancelar_Click"/>
        </StackPanel>
    </Grid>
</Window>
