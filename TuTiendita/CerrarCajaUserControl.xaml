<UserControl x:Class="TuTiendita.CerrarCajaUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="20">
            <StackPanel>
                <TextBlock Text="Gestión de Turnos / Caja" FontSize="24" FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="txtEstadoTurno" Text="No hay turno abierto" FontSize="14" Foreground="#ECF0F1" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Shift Controls -->
            <Border Grid.Row="0" BorderBrush="#BDC3C7" BorderThickness="1" Padding="20" Margin="0,0,0,20" CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="Control de Turno" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                    <StackPanel x:Name="pnlAbrirTurno" Visibility="Visible">
                        <TextBlock Text="Abrir Nuevo Turno" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Monto Inicial en Caja:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox x:Name="txtMontoInicial" Width="150" Height="30" VerticalContentAlignment="Center"/>
                            <Button x:Name="btnAbrirTurno" Content="Abrir Turno" Width="120" Height="35"
                                    Background="#27AE60" Foreground="White" BorderThickness="0"
                                    Margin="20,0,0,0" Click="BtnAbrirTurno_Click" Cursor="Hand"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="pnlCerrarTurno" Visibility="Collapsed">
                        <TextBlock Text="Cerrar Turno Actual" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Monto Inicial:" FontWeight="SemiBold" Margin="0,5"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="txtMontoInicialActual" Text="$0.00" Margin="0,5"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Total Ventas:" FontWeight="SemiBold" Margin="0,5"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtTotalVentasActual" Text="$0.00" Margin="0,5"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Monto Final en Caja:" FontWeight="SemiBold" Margin="0,5"/>
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtMontoFinal" Width="150" Height="30"
                                     VerticalContentAlignment="Center" Margin="0,5"/>

                            <Button Grid.Row="2" Grid.Column="2" x:Name="btnCerrarTurno" Content="Cerrar Turno"
                                    Width="140" Height="35" Background="#E74C3C" Foreground="White"
                                    BorderThickness="0" Margin="10,5,0,5" Click="BtnCerrarTurno_Click" Cursor="Hand"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Current Shift Info -->
            <Border Grid.Row="1" x:Name="pnlInfoTurno" BorderBrush="#BDC3C7" BorderThickness="1"
                    Padding="20" Margin="0,0,0,20" CornerRadius="5" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Información del Turno Actual" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Usuario:" FontWeight="SemiBold" Margin="0,5,15,5"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="txtUsuarioTurno" Text="" Margin="0,5"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Apertura:" FontWeight="SemiBold" Margin="0,5,15,5"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtFechaApertura" Text="" Margin="0,5"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Ventas Realizadas:" FontWeight="SemiBold" Margin="0,5,15,5"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="txtNumeroVentas" Text="0" Margin="0,5"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Shift History -->
            <Border Grid.Row="2" BorderBrush="#BDC3C7" BorderThickness="1" Padding="20" CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="Historial de Turnos" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                    <DataGrid x:Name="dgTurnos" AutoGenerateColumns="False" IsReadOnly="True"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              AlternatingRowBackground="#F8F9FA" RowHeight="35">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="Usuario" Binding="{Binding UsuarioNombre}" Width="120"/>
                            <DataGridTextColumn Header="Apertura" Binding="{Binding FechaApertura}" Width="150"/>
                            <DataGridTextColumn Header="Cierre" Binding="{Binding FechaCierre}" Width="150"/>
                            <DataGridTextColumn Header="Monto Inicial" Binding="{Binding MontoInicialFormateado}" Width="120"/>
                            <DataGridTextColumn Header="Monto Final" Binding="{Binding MontoFinalFormateado}" Width="120"/>
                            <DataGridTextColumn Header="Total Ventas" Binding="{Binding TotalVentasFormateado}" Width="120"/>
                            <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
