<Window x:Class="TuTiendita.DialogoPagoEfectivo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pago en Efectivo" Height="480" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5">
    <Grid>
        <!-- Header -->
        <Border Background="#27AE60" Height="70" VerticalAlignment="Top">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="PAGO EN EFECTIVO" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="Ingrese el monto recibido del cliente" FontSize="12" Foreground="#A9DFBF" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <StackPanel Margin="25,90,25,25">
            <!-- Total a Pagar -->
            <Border Background="#2C3E50" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="TOTAL A PAGAR" FontSize="14" Foreground="#95A5A6" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="txtTotalPagar" Text="$0.00" FontSize="36" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Monto Recibido -->
            <TextBlock Text="Cliente paga con:" FontWeight="SemiBold" FontSize="14" Foreground="#333" Margin="0,0,0,8"/>
            <Grid>
                <TextBox x:Name="txtMontoRecibido" Height="50" FontSize="24" FontWeight="Bold"
                         Padding="45,10,10,10" BorderBrush="#DDD" BorderThickness="2"
                         TextChanged="TxtMontoRecibido_TextChanged"
                         PreviewTextInput="TxtMontoRecibido_PreviewTextInput"
                         KeyDown="TxtMontoRecibido_KeyDown"/>
                <TextBlock Text="$" FontSize="24" FontWeight="Bold" Foreground="#27AE60"
                           VerticalAlignment="Center" Margin="15,0,0,0" IsHitTestVisible="False"/>
            </Grid>

            <!-- Botones de Monto Rapido -->
            <TextBlock Text="Montos rapidos:" FontSize="12" Foreground="#666" Margin="0,15,0,8"/>
            <WrapPanel HorizontalAlignment="Center">
                <Button Content="$20" Width="60" Height="35" Margin="3" Tag="20" Click="BtnMontoRapido_Click"
                        Background="#ECF0F1" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                <Button Content="$50" Width="60" Height="35" Margin="3" Tag="50" Click="BtnMontoRapido_Click"
                        Background="#ECF0F1" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                <Button Content="$100" Width="60" Height="35" Margin="3" Tag="100" Click="BtnMontoRapido_Click"
                        Background="#ECF0F1" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                <Button Content="$200" Width="60" Height="35" Margin="3" Tag="200" Click="BtnMontoRapido_Click"
                        Background="#ECF0F1" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                <Button Content="$500" Width="60" Height="35" Margin="3" Tag="500" Click="BtnMontoRapido_Click"
                        Background="#ECF0F1" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                <Button Content="$1000" Width="60" Height="35" Margin="3" Tag="1000" Click="BtnMontoRapido_Click"
                        Background="#ECF0F1" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
            </WrapPanel>

            <!-- Cambio -->
            <Border x:Name="brdCambio" Background="#E8F8F5" CornerRadius="8" Padding="15" Margin="0,20,0,0"
                    BorderBrush="#27AE60" BorderThickness="2">
                <StackPanel>
                    <TextBlock Text="CAMBIO A DEVOLVER" FontSize="12" Foreground="#27AE60" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtCambio" Text="$0.00" FontSize="32" FontWeight="Bold" Foreground="#27AE60" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Mensaje de Error -->
            <TextBlock x:Name="txtError" Text="" FontSize="12" Foreground="#E74C3C"
                       HorizontalAlignment="Center" Margin="0,10,0,0" Visibility="Collapsed"/>

            <!-- Botones -->
            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Cancelar" Height="45" Margin="0,0,5,0"
                        Click="BtnCancelar_Click" Background="#E0E0E0" Foreground="#333"
                        BorderThickness="0" FontSize="14" Cursor="Hand"/>
                <Button x:Name="btnConfirmar" Grid.Column="1" Content="Confirmar Pago" Height="45" Margin="5,0,0,0"
                        Click="BtnConfirmar_Click" Background="#27AE60" Foreground="White"
                        FontWeight="Bold" BorderThickness="0" FontSize="14" Cursor="Hand" IsEnabled="False"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
