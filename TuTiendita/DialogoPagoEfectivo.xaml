<Window x:Class="TuTiendita.DialogoPagoEfectivo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pago en Efectivo"
        MinHeight="520" MinWidth="400"
        SizeToContent="Height" Width="420"
        MaxHeight="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#F5F5F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#27AE60" Padding="20,15">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="PAGO EN EFECTIVO" FontSize="22" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="Ingrese el monto recibido del cliente" FontSize="12"
                           Foreground="#A9DFBF" HorizontalAlignment="Center" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Content con ScrollViewer -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="25,20,25,25">
                <!-- Total a Pagar -->
                <Border Background="#2C3E50" CornerRadius="10" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="TOTAL A PAGAR" FontSize="14" Foreground="#95A5A6"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtTotalPagar" Text="$0.00" FontSize="38"
                                   FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Monto Recibido -->
                <TextBlock Text="Cliente paga con:" FontWeight="SemiBold" FontSize="14"
                           Foreground="#333" Margin="0,0,0,8"/>
                <Border Background="White" CornerRadius="8" BorderBrush="#27AE60"
                        BorderThickness="2" Margin="0,0,0,5">
                    <Grid>
                        <TextBox x:Name="txtMontoRecibido" Height="55" FontSize="26" FontWeight="Bold"
                                 Padding="50,10,15,10" BorderThickness="0" Background="Transparent"
                                 TextChanged="TxtMontoRecibido_TextChanged"
                                 PreviewTextInput="TxtMontoRecibido_PreviewTextInput"
                                 KeyDown="TxtMontoRecibido_KeyDown"
                                 VerticalContentAlignment="Center"/>
                        <TextBlock Text="$" FontSize="26" FontWeight="Bold" Foreground="#27AE60"
                                   VerticalAlignment="Center" Margin="18,0,0,0" IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <!-- Botones de Monto Rapido -->
                <TextBlock Text="Montos rapidos:" FontSize="12" Foreground="#666" Margin="0,15,0,8"/>
                <UniformGrid Rows="2" Columns="3" Margin="0,0,0,5">
                    <Button Content="$20" Height="42" Margin="3" Tag="20" Click="BtnMontoRapido_Click"
                            Background="#ECF0F1" BorderThickness="0" FontWeight="Bold" FontSize="14" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="$50" Height="42" Margin="3" Tag="50" Click="BtnMontoRapido_Click"
                            Background="#ECF0F1" BorderThickness="0" FontWeight="Bold" FontSize="14" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="$100" Height="42" Margin="3" Tag="100" Click="BtnMontoRapido_Click"
                            Background="#ECF0F1" BorderThickness="0" FontWeight="Bold" FontSize="14" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="$200" Height="42" Margin="3" Tag="200" Click="BtnMontoRapido_Click"
                            Background="#ECF0F1" BorderThickness="0" FontWeight="Bold" FontSize="14" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="$500" Height="42" Margin="3" Tag="500" Click="BtnMontoRapido_Click"
                            Background="#ECF0F1" BorderThickness="0" FontWeight="Bold" FontSize="14" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="$1000" Height="42" Margin="3" Tag="1000" Click="BtnMontoRapido_Click"
                            Background="#ECF0F1" BorderThickness="0" FontWeight="Bold" FontSize="14" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </UniformGrid>

                <!-- Boton Monto Exacto -->
                <Button Content="Monto Exacto" Height="38" Margin="3,10,3,0"
                        Click="BtnMontoExacto_Click"
                        Background="#3498DB" Foreground="White" FontWeight="Bold"
                        FontSize="13" Cursor="Hand" BorderThickness="0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Cambio -->
                <Border x:Name="brdCambio" Background="#E8F8F5" CornerRadius="10" Padding="18" Margin="0,20,0,0"
                        BorderBrush="#27AE60" BorderThickness="2">
                    <StackPanel>
                        <TextBlock Text="CAMBIO A DEVOLVER" FontSize="12" Foreground="#27AE60"
                                   HorizontalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBlock x:Name="txtCambio" Text="$0.00" FontSize="34" FontWeight="Bold"
                                   Foreground="#27AE60" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Mensaje de Error -->
                <TextBlock x:Name="txtError" Text="" FontSize="12" Foreground="#E74C3C"
                           HorizontalAlignment="Center" Margin="0,10,0,0" Visibility="Collapsed"
                           TextWrapping="Wrap"/>

                <!-- Botones -->
                <Grid Margin="0,20,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="Cancelar" Height="48" Margin="0,0,5,0"
                            Click="BtnCancelar_Click" Background="#E0E0E0" Foreground="#333"
                            BorderThickness="0" FontSize="15" Cursor="Hand" IsCancel="True">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button x:Name="btnConfirmar" Grid.Column="1" Content="Confirmar Pago" Height="48" Margin="5,0,0,0"
                            Click="BtnConfirmar_Click" Background="#27AE60" Foreground="White"
                            FontWeight="Bold" BorderThickness="0" FontSize="15" Cursor="Hand" IsEnabled="False">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="border" Property="Background" Value="#BDC3C7"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
