<Window x:Class="TuTiendita.VentanaConfiguracionFiscal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración Fiscal del Emisor - CFDI 4.0"
        Height="750" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="RequiredLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="BorderBrush" Value="#DDD"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2196F3"/>
            <Setter Property="Margin" Value="0,10,0,15"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="30">
            <StackPanel>
                <!-- Encabezado -->
                <TextBlock Text="Configuración Fiscal del Emisor"
                           FontSize="22" FontWeight="Bold" Foreground="#333"
                           Margin="0,0,0,5"/>
                <TextBlock Text="Configure los datos fiscales de su empresa para emitir facturas electrónicas CFDI 4.0"
                           FontSize="13" Foreground="#666" Margin="0,0,0,20"/>

                <!-- Sección: Datos del Emisor -->
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Datos del Emisor" Style="{StaticResource SectionTitle}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Column="0" Grid.Row="0">
                                <TextBlock Style="{StaticResource RequiredLabel}">
                                    <Run Text="RFC del Emisor"/>
                                    <Run Text="*" Foreground="Red"/>
                                </TextBlock>
                                <TextBox x:Name="txtRFC" Style="{StaticResource InputStyle}"
                                         MaxLength="13" CharacterCasing="Upper"
                                         ToolTip="RFC de 12 caracteres (persona moral) o 13 caracteres (persona física)"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Grid.Row="0">
                                <TextBlock Style="{StaticResource RequiredLabel}">
                                    <Run Text="Régimen Fiscal"/>
                                    <Run Text="*" Foreground="Red"/>
                                </TextBlock>
                                <ComboBox x:Name="cmbRegimenFiscal" Style="{StaticResource ComboStyle}"
                                          DisplayMemberPath="ToString"/>
                            </StackPanel>

                            <StackPanel Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="3">
                                <TextBlock Style="{StaticResource RequiredLabel}">
                                    <Run Text="Razón Social / Nombre"/>
                                    <Run Text="*" Foreground="Red"/>
                                </TextBlock>
                                <TextBox x:Name="txtRazonSocial" Style="{StaticResource InputStyle}"
                                         CharacterCasing="Upper"
                                         ToolTip="Debe coincidir exactamente con la constancia de situación fiscal"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Sección: Domicilio Fiscal -->
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Domicilio Fiscal" Style="{StaticResource SectionTitle}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Calle" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="txtCalle" Style="{StaticResource InputStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="No. Exterior" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="txtNumExterior" Style="{StaticResource InputStyle}" Width="100"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="No. Interior" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="txtNumInterior" Style="{StaticResource InputStyle}" Width="100"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Colonia" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="txtColonia" Style="{StaticResource InputStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource RequiredLabel}">
                                    <Run Text="Código Postal"/>
                                    <Run Text="*" Foreground="Red"/>
                                </TextBlock>
                                <TextBox x:Name="txtCodigoPostal" Style="{StaticResource InputStyle}"
                                         MaxLength="5"
                                         ToolTip="Código postal del domicilio fiscal (5 dígitos)"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Municipio / Alcaldía" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="txtMunicipio" Style="{StaticResource InputStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Estado" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="txtEstado" Style="{StaticResource InputStyle}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Sección: Configuración de Facturación -->
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Configuración de Facturación" Style="{StaticResource SectionTitle}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Serie" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="txtSerie" Style="{StaticResource InputStyle}"
                                         Width="80" MaxLength="10" CharacterCasing="Upper"
                                         Text="A"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Último Folio" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="txtUltimoFolio" Style="{StaticResource InputStyle}"
                                         Width="100" Text="0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Lugar de Expedición (CP)" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="txtLugarExpedicion" Style="{StaticResource InputStyle}"
                                         MaxLength="5"
                                         ToolTip="Si es diferente al domicilio fiscal"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Sección: Certificados y PAC (Opcional) -->
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Certificados y PAC (Opcional para timbrado)" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Configure estos campos si desea integrar con un Proveedor Autorizado de Certificación para timbrado automático."
                                   FontSize="12" Foreground="#666" Margin="0,0,0,15" TextWrapping="Wrap"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Certificado CSD (.cer)" Style="{StaticResource LabelStyle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="txtCertificado" Grid.Column="0"
                                             Style="{StaticResource InputStyle}" IsReadOnly="True"/>
                                    <Button x:Name="btnSeleccionarCer" Grid.Column="1"
                                            Content="..." Width="40" Margin="5,0,0,15"
                                            Click="btnSeleccionarCer_Click"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Llave Privada (.key)" Style="{StaticResource LabelStyle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="txtLlave" Grid.Column="0"
                                             Style="{StaticResource InputStyle}" IsReadOnly="True"/>
                                    <Button x:Name="btnSeleccionarKey" Grid.Column="1"
                                            Content="..." Width="40" Margin="5,0,0,15"
                                            Click="btnSeleccionarKey_Click"/>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <StackPanel>
                            <TextBlock Text="Contraseña de la Llave" Style="{StaticResource LabelStyle}"/>
                            <PasswordBox x:Name="txtContrasenaLlave" Padding="10,8" FontSize="14"
                                         Margin="0,0,0,15" MaxWidth="300" HorizontalAlignment="Left"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Proveedor PAC" Style="{StaticResource LabelStyle}"/>
                                <ComboBox x:Name="cmbPAC" Style="{StaticResource ComboStyle}">
                                    <ComboBoxItem Content="(Sin configurar)"/>
                                    <ComboBoxItem Content="Finkok"/>
                                    <ComboBoxItem Content="Facturama"/>
                                    <ComboBoxItem Content="SW Sapien"/>
                                    <ComboBoxItem Content="Diverza"/>
                                    <ComboBoxItem Content="Otro"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Usuario PAC" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="txtPACUsuario" Style="{StaticResource InputStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Contraseña PAC" Style="{StaticResource LabelStyle}"/>
                                <PasswordBox x:Name="txtPACContrasena" Padding="10,8" FontSize="14"
                                             Margin="0,0,0,15"/>
                            </StackPanel>
                        </Grid>

                        <CheckBox x:Name="chkModoProduccion" Content="Modo Producción (desmarcar para pruebas)"
                                  FontSize="13" Margin="0,0,0,10"/>
                    </StackPanel>
                </Border>

                <!-- Nota informativa -->
                <Border Background="#E3F2FD" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ℹ" FontSize="18" Foreground="#2196F3" Margin="0,0,10,0"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#1565C0" FontSize="12">
                            <Run FontWeight="SemiBold">Importante:</Run>
                            <Run Text=" Los datos del emisor deben coincidir exactamente con la Constancia de Situación Fiscal del SAT. El nombre y RFC se validan en tiempo real al timbrar."/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Botones de acción -->
        <Border Grid.Row="1" Background="White" Padding="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="-2" Opacity="0.1"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnCancelar" Content="Cancelar"
                        Padding="25,12" FontSize="14"
                        Click="btnCancelar_Click" Margin="0,0,10,0"/>
                <Button x:Name="btnGuardar" Content="Guardar Configuración"
                        Background="#4CAF50" Foreground="White"
                        Padding="25,12" FontSize="14" FontWeight="SemiBold"
                        BorderThickness="0" Click="btnGuardar_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
