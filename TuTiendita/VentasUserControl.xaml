<UserControl x:Class="TuTiendita.VentasUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="200"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="🛒 Punto de Venta" FontSize="24" FontWeight="Bold"/>
            <TextBlock Text="Realiza ventas rápidas y eficientes escaneando o buscando productos"
                       FontSize="13" Foreground="#7F8C8D" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Estado del Turno (Alerta) -->
        <Border Grid.Row="1" x:Name="brdEstadoTurno" Background="#E74C3C" CornerRadius="8"
                Padding="15" Margin="0,0,0,20" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock x:Name="txtEstadoTurno" Text="⚠️ NO HAY TURNO ABIERTO - Por favor abra un turno en Gestión de Turno para realizar ventas"
                           Foreground="White" FontWeight="Bold" FontSize="14"/>
            </StackPanel>
        </Border>

        <!-- Panel de Ventas -->
        <Grid x:Name="pnlVentas" Grid.Row="2" Grid.RowSpan="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="200"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Búsqueda de Productos -->
            <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                    CornerRadius="10" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="🔍 Buscar Productos" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

                    <Border Background="White" BorderBrush="#BDC3C7" BorderThickness="1"
                            CornerRadius="5" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔎" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox x:Name="txtBuscarProducto" Grid.Column="1" BorderThickness="0"
                                     VerticalAlignment="Center" FontSize="14"
                                     TextChanged="TxtBuscarProducto_TextChanged">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Background">
                                                    <Setter.Value>
                                                        <VisualBrush Stretch="None" AlignmentX="Left">
                                                            <VisualBrush.Visual>
                                                                <TextBlock Text="Buscar por código o descripción del producto..."
                                                                           Foreground="#95A5A6" FontSize="14"/>
                                                            </VisualBrush.Visual>
                                                        </VisualBrush>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Productos Encontrados -->
            <Border Grid.Row="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                    CornerRadius="10" Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F8F9FA" Padding="15">
                        <StackPanel>
                            <TextBlock Text="📦 Productos Disponibles" FontSize="14" FontWeight="Bold"/>
                            <TextBlock Text="Haz doble clic en un producto para agregarlo al carrito"
                                       FontSize="11" Foreground="#7F8C8D" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <DataGrid x:Name="dgProductos" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              MouseDoubleClick="DgProductos_MouseDoubleClick"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              RowHeight="40" AlternatingRowBackground="#F8F9FA">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Descripción" Binding="{Binding Nombre}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="13"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Precio" Binding="{Binding Precio, StringFormat=C}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#27AE60"/>
                                        <Setter Property="FontSize" Value="14"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Cursor" Value="Hand"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StockBajo}" Value="True">
                                        <Setter Property="Background" Value="#FFF3CD"/>
                                        <Setter Property="Foreground" Value="#856404"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SinStock}" Value="True">
                                        <Setter Property="Background" Value="#FFCDD2"/>
                                        <Setter Property="Foreground" Value="#B71C1C"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Carrito de Compras -->
            <Border Grid.Row="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                    CornerRadius="10" Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#3498DB" Padding="15">
                        <TextBlock Text="🛒 Carrito de Compras" FontSize="15" FontWeight="Bold" Foreground="White"/>
                    </Border>

                    <DataGrid x:Name="dgVenta" Grid.Row="1" AutoGenerateColumns="False"
                              CanUserAddRows="False" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" RowHeight="45"
                              AlternatingRowBackground="#F8F9FA">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="110" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Descripción" Binding="{Binding Nombre}" Width="*" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="13"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="FontSize" Value="14"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Precio Unit." Binding="{Binding Precio, StringFormat=C}" Width="120" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                        <Setter Property="Foreground" Value="#7F8C8D"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat=C}" Width="130" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#27AE60"/>
                                        <Setter Property="FontSize" Value="14"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Acciones" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="🗑️ Quitar" Click="BtnEliminarItem_Click"
                                                Background="#E74C3C" Foreground="White" FontWeight="Bold"
                                                BorderThickness="0" Padding="10,5" Cursor="Hand" FontSize="11"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Total y Acciones -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Total -->
                <Border Grid.Column="0" Background="#2C3E50" CornerRadius="10" Padding="20" Margin="0,0,10,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="💰 TOTAL A PAGAR:" FontSize="18" FontWeight="Bold"
                                   Foreground="White" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="txtTotal" Text="$0.00" FontSize="36" FontWeight="Bold"
                                   Foreground="#2ECC71" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Botones de Acción -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="🧹 Limpiar Carrito" Width="160" Height="60"
                            Background="#95A5A6" Foreground="White" FontWeight="Bold" FontSize="14"
                            BorderThickness="0" Margin="0,0,10,0" Click="BtnLimpiar_Click" Cursor="Hand"/>
                    <Button Content="💳 Procesar Venta" Width="180" Height="60"
                            Background="#27AE60" Foreground="White" FontWeight="Bold" FontSize="15"
                            BorderThickness="0" Click="BtnVender_Click" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
