<UserControl x:Class="TuTiendita.FacturacionUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200"
             Background="#F5F5F5">

    <UserControl.Resources>
        <!-- Estilos para el módulo de facturación -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.1"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#43A047"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E88E5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ConfigButton" TargetType="Button">
            <Setter Property="Background" Value="#FF9800"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F57C00"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Facturación Electrónica CFDI 4.0"
                               FontSize="24" FontWeight="Bold" Foreground="#333"/>
                    <TextBlock x:Name="txtConfigStatus"
                               Text="Estado: Configuración pendiente"
                               FontSize="13" Foreground="#FF9800" Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="btnConfigurarEmisor"
                            Content="Configurar Datos Fiscales"
                            Style="{StaticResource ConfigButton}"
                            Click="btnConfigurarEmisor_Click"
                            Margin="0,0,10,0"/>
                    <Button x:Name="btnNuevaFactura"
                            Content="Nueva Factura"
                            Style="{StaticResource PrimaryButton}"
                            Click="btnNuevaFactura_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tarjetas de estadísticas -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <TextBlock Text="Total Facturas" FontSize="12" Foreground="#666"/>
                    <TextBlock x:Name="txtTotalFacturas" Text="0"
                               FontSize="28" FontWeight="Bold" Foreground="#333"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <TextBlock Text="Timbradas" FontSize="12" Foreground="#666"/>
                    <TextBlock x:Name="txtTimbradas" Text="0"
                               FontSize="28" FontWeight="Bold" Foreground="#4CAF50"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <TextBlock Text="Pendientes" FontSize="12" Foreground="#666"/>
                    <TextBlock x:Name="txtPendientes" Text="0"
                               FontSize="28" FontWeight="Bold" Foreground="#FF9800"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <TextBlock Text="Canceladas" FontSize="12" Foreground="#666"/>
                    <TextBlock x:Name="txtCanceladas" Text="0"
                               FontSize="28" FontWeight="Bold" Foreground="#F44336"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <TextBlock Text="Monto Total" FontSize="12" Foreground="#666"/>
                    <TextBlock x:Name="txtMontoTotal" Text="$0.00"
                               FontSize="22" FontWeight="Bold" Foreground="#2196F3"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Filtros y búsqueda -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                    <TextBlock Text="Estado" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                    <ComboBox x:Name="cmbFiltroEstado" Width="150"
                              SelectionChanged="cmbFiltroEstado_SelectionChanged">
                        <ComboBoxItem Content="Todos" IsSelected="True"/>
                        <ComboBoxItem Content="Timbrado"/>
                        <ComboBoxItem Content="Pendiente"/>
                        <ComboBoxItem Content="Cancelado"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,15,0">
                    <TextBlock Text="Desde" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                    <DatePicker x:Name="dpFechaInicio" Width="130"
                                SelectedDateChanged="dpFecha_SelectedDateChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,15,0">
                    <TextBlock Text="Hasta" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                    <DatePicker x:Name="dpFechaFin" Width="130"
                                SelectedDateChanged="dpFecha_SelectedDateChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="0,0,15,0">
                    <TextBlock Text="Buscar" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtBuscar" Width="200" Padding="8"
                             TextChanged="txtBuscar_TextChanged"
                             ToolTip="Buscar por UUID, Folio, RFC o Nombre"/>
                </StackPanel>

                <StackPanel Grid.Column="5" VerticalAlignment="Bottom" Orientation="Horizontal">
                    <Button x:Name="btnLimpiarFiltros" Content="Limpiar"
                            Style="{StaticResource SecondaryButton}"
                            Click="btnLimpiarFiltros_Click" Margin="0,0,10,0"/>
                    <Button x:Name="btnActualizar" Content="Actualizar"
                            Style="{StaticResource SecondaryButton}"
                            Click="btnActualizar_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Lista de facturas -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Facturas Emitidas"
                           FontSize="16" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,15"/>

                <DataGrid x:Name="dgFacturas" Grid.Row="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          BorderThickness="0"
                          Background="White"
                          RowHeight="45"
                          MouseDoubleClick="dgFacturas_MouseDoubleClick">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Folio" Binding="{Binding FolioCompleto}" Width="100"/>
                        <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="150"/>
                        <DataGridTextColumn Header="RFC Receptor" Binding="{Binding ReceptorRFC}" Width="140"/>
                        <DataGridTextColumn Header="Receptor" Binding="{Binding ReceptorNombre}" Width="200"/>
                        <DataGridTextColumn Header="Uso CFDI" Binding="{Binding UsoCFDIDescripcion}" Width="180"/>
                        <DataGridTextColumn Header="Total" Binding="{Binding TotalFormateado}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="Estado" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="12" Padding="10,5"
                                            HorizontalAlignment="Center"
                                            Background="{Binding EstadoColor}">
                                        <TextBlock Text="{Binding Estado}"
                                                   Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="UUID" Binding="{Binding UUID}" Width="280"/>
                        <DataGridTemplateColumn Header="Acciones" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="Ver"
                                                Padding="8,4" Margin="2"
                                                Click="btnVerFactura_Click"
                                                Tag="{Binding Id}"
                                                Cursor="Hand"/>
                                        <Button Content="PDF"
                                                Padding="8,4" Margin="2"
                                                Click="btnDescargarPDF_Click"
                                                Tag="{Binding Id}"
                                                Cursor="Hand"/>
                                        <Button Content="XML"
                                                Padding="8,4" Margin="2"
                                                Click="btnDescargarXML_Click"
                                                Tag="{Binding Id}"
                                                Cursor="Hand"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Mensaje cuando no hay facturas -->
                <StackPanel x:Name="panelSinFacturas" Grid.Row="1"
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="Collapsed">
                    <TextBlock Text="No hay facturas registradas"
                               FontSize="18" Foreground="#999"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Presione 'Nueva Factura' para crear una"
                               FontSize="13" Foreground="#BBB"
                               HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
