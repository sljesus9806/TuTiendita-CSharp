<UserControl x:Class="TuTiendita.Controls.PanelEstadoHardware"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="35">

    <UserControl.Resources>
        <Style x:Key="IndicadorEstado" TargetType="Border">
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="TextoIndicador" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </UserControl.Resources>

    <Border Background="#34495E" BorderBrush="#2C3E50" BorderThickness="0,1,0,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Indicadores de dispositivos -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="10,0">

                <!-- Indicador de Báscula -->
                <Border x:Name="brdBascula" Style="{StaticResource IndicadorEstado}"
                        Background="#95A5A6" ToolTip="Báscula: No configurada"
                        MouseLeftButtonUp="Dispositivo_Click" Tag="Bascula">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚖" FontSize="14" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtBascula" Text="Báscula" Style="{StaticResource TextoIndicador}"/>
                        <TextBlock x:Name="txtBasculaEstado" Text="○" Margin="5,0,0,0"
                                   Style="{StaticResource TextoIndicador}" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <!-- Indicador de Impresora Tickets -->
                <Border x:Name="brdImpresora" Style="{StaticResource IndicadorEstado}"
                        Background="#95A5A6" ToolTip="Impresora: No configurada"
                        MouseLeftButtonUp="Dispositivo_Click" Tag="Impresora">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🖨" FontSize="14" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtImpresora" Text="Impresora" Style="{StaticResource TextoIndicador}"/>
                        <TextBlock x:Name="txtImpresoraEstado" Text="○" Margin="5,0,0,0"
                                   Style="{StaticResource TextoIndicador}" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <!-- Indicador de Lector de Código de Barras -->
                <Border x:Name="brdLector" Style="{StaticResource IndicadorEstado}"
                        Background="#95A5A6" ToolTip="Lector: No configurado"
                        MouseLeftButtonUp="Dispositivo_Click" Tag="Lector">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📷" FontSize="14" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtLector" Text="Lector" Style="{StaticResource TextoIndicador}"/>
                        <TextBlock x:Name="txtLectorEstado" Text="○" Margin="5,0,0,0"
                                   Style="{StaticResource TextoIndicador}" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <!-- Indicador de Red/Internet -->
                <Border x:Name="brdRed" Style="{StaticResource IndicadorEstado}"
                        Background="#95A5A6" ToolTip="Red: Verificando..."
                        MouseLeftButtonUp="Dispositivo_Click" Tag="Red">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🌐" FontSize="14" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtRed" Text="Internet" Style="{StaticResource TextoIndicador}"/>
                        <TextBlock x:Name="txtRedEstado" Text="○" Margin="5,0,0,0"
                                   Style="{StaticResource TextoIndicador}" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- Mensajes/Estado general -->
            <TextBlock x:Name="txtMensajeEstado" Grid.Column="1"
                       Text="" Foreground="#BDC3C7" FontSize="11"
                       VerticalAlignment="Center" HorizontalAlignment="Center"/>

            <!-- Controles -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0">

                <!-- Última verificación -->
                <TextBlock x:Name="txtUltimaVerificacion" Text="Última: --:--:--"
                           Foreground="#7F8C8D" FontSize="10" VerticalAlignment="Center"
                           Margin="0,0,10,0"/>

                <!-- Botón refrescar -->
                <Button x:Name="btnRefrescar" Content="↻" Width="25" Height="25"
                        Background="Transparent" Foreground="White" BorderThickness="0"
                        FontSize="14" FontWeight="Bold" Cursor="Hand"
                        ToolTip="Verificar ahora" Click="btnRefrescar_Click"/>

                <!-- Botón configuración -->
                <Button x:Name="btnConfigHardware" Content="⚙" Width="25" Height="25"
                        Background="Transparent" Foreground="White" BorderThickness="0"
                        FontSize="14" Cursor="Hand"
                        ToolTip="Configurar hardware" Click="btnConfigHardware_Click"/>

            </StackPanel>
        </Grid>
    </Border>
</UserControl>
