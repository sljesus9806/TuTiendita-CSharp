<Window x:Class="TuTiendita.VentanaOrdenCompra"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nueva Orden de Compra" Height="800" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">

    <Window.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern TextBox Style -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderBrush" Value="#DFE4EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#3498DB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern ComboBox Style -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderBrush" Value="#DFE4EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Card Style -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="📦 Nueva Orden de Compra" FontSize="28" FontWeight="Bold" Foreground="#2C3E50"/>
                <TextBlock x:Name="txtProveedor" FontSize="15" Foreground="#7F8C8D" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- Payment Information Card -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,15" Background="#E8F5E9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Payment Type -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="💳 Tipo de Pago" FontWeight="Bold" FontSize="14" Foreground="#2C3E50" Margin="0,0,0,8"/>
                    <ComboBox x:Name="cmbTipoPago" Height="42" Style="{StaticResource ModernComboBox}"
                              SelectionChanged="CmbTipoPago_SelectionChanged">
                        <ComboBoxItem Content="💵 Contado" IsSelected="True"/>
                        <ComboBoxItem Content="💳 Crédito"/>
                    </ComboBox>
                </StackPanel>

                <!-- Credit Days (only visible when Credit is selected) -->
                <StackPanel Grid.Column="2" x:Name="pnlDiasCredito" Visibility="Collapsed">
                    <TextBlock Text="📅 Días de Crédito" FontWeight="Bold" FontSize="14" Foreground="#2C3E50" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtDiasCredito" Text="30" Height="42" Style="{StaticResource ModernTextBox}"
                                 TextChanged="TxtDiasCredito_TextChanged" Grid.Column="0"/>
                        <TextBlock x:Name="txtFechaVencimiento" Text="" FontSize="12" Foreground="#7F8C8D"
                                   VerticalAlignment="Center" Grid.Column="2"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Product Search and Add Card -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Search Product -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="🔍 Buscar Producto" FontWeight="Bold" FontSize="14" Foreground="#2C3E50" Margin="0,0,0,8"/>
                        <ComboBox x:Name="cmbProductos" Height="42" Style="{StaticResource ModernComboBox}"
                                  IsEditable="True" IsTextSearchEnabled="True"
                                  SelectionChanged="CmbProductos_SelectionChanged"/>
                    </StackPanel>

                    <Button x:Name="btnAgregar" Grid.Column="2" Content="➕ Agregar Producto" Height="42"
                            Background="#27AE60" Foreground="White" Style="{StaticResource ModernButton}"
                            VerticalAlignment="Bottom" Click="BtnAgregar_Click" FontSize="14" Padding="20,10"/>
                </Grid>

                <!-- Product Details -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="📦 Cantidad" FontWeight="Bold" FontSize="13" Foreground="#2C3E50" Margin="0,0,0,8"/>
                        <TextBox x:Name="txtCantidad" Text="1" Height="42" Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="💰 Precio Unitario" FontWeight="Bold" FontSize="13" Foreground="#2C3E50" Margin="0,0,0,8"/>
                        <TextBox x:Name="txtPrecio" Text="0" Height="42" Style="{StaticResource ModernTextBox}"
                                 TextChanged="TxtPrecio_TextChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="💵 Subtotal" FontWeight="Bold" FontSize="13" Foreground="#2C3E50" Margin="0,0,0,8"/>
                        <TextBox x:Name="txtSubtotal" Text="$0.00" Height="42" Style="{StaticResource ModernTextBox}"
                                 IsReadOnly="True" Background="#F8F9FA" FontWeight="Bold" Foreground="#27AE60"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Order Details DataGrid -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,0,0,15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="📋 Productos de la Orden" FontSize="16" FontWeight="Bold"
                           Foreground="#2C3E50" Margin="0,0,0,15"/>

                <DataGrid Grid.Row="1" x:Name="dgDetalles" AutoGenerateColumns="False"
                          CanUserAddRows="False" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" RowHeight="45"
                          AlternatingRowBackground="#F8F9FA"
                          BorderThickness="0">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#ECF0F1"/>
                            <Setter Property="Foreground" Value="#2C3E50"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="10"/>
                            <Setter Property="BorderThickness" Value="0,0,0,2"/>
                            <Setter Property="BorderBrush" Value="#DFE4EA"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Producto" Binding="{Binding ProductoNombre}" Width="*" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Padding" Value="10,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Precio Unit." Binding="{Binding PrecioUnitarioFormateado}" Width="140" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="Padding" Value="0,0,10,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Subtotal" Binding="{Binding SubtotalFormateado}" Width="140" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#27AE60"/>
                                    <Setter Property="Padding" Value="0,0,10,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="Acciones" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="🗑️ " Width="70" Height="32"
                                            Background="#E74C3C" Foreground="White"
                                            Style="{StaticResource ModernButton}"
                                            Click="BtnEliminarDetalle_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Totals -->
        <Border Grid.Row="4" Margin="0,0,0,20" CornerRadius="8" Background="#3498DB" Padding="25">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="TOTAL DE LA ORDEN" FontSize="14" Foreground="White" Opacity="0.9" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtTotalOrden" Text="$0.00" FontSize="36" FontWeight="Bold" Foreground="White" Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="txtTotalItems" Text="0 productos" FontSize="16" Foreground="White"
                               Opacity="0.9" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtInfoPago" Text="" FontSize="13" Foreground="White"
                               Opacity="0.85" HorizontalAlignment="Right" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Buttons -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="btnCancelar" Grid.Column="0" Content="❌ Cancelar" Width="140" Height="45"
                    Background="#95A5A6" Foreground="White" Style="{StaticResource ModernButton}"
                    Click="BtnCancelar_Click" FontSize="14"/>

            <Button x:Name="btnGuardar" Grid.Column="2" Content="💾 Crear Orden" Width="160" Height="45"
                    Background="#27AE60" Foreground="White" Style="{StaticResource ModernButton}"
                    Click="BtnGuardar_Click" FontSize="15"/>

            <Button x:Name="btnGuardarRecibir" Grid.Column="4" Content="✅ Crear y Recibir" Width="180" Height="45"
                    Background="#2980B9" Foreground="White" Style="{StaticResource ModernButton}"
                    Click="BtnGuardarRecibir_Click" FontSize="15"/>
        </Grid>
    </Grid>
</Window>
