<Window x:Class="TuTiendita.DialogoMetodoPago"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Método de Pago" Height="220" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Seleccione el método de pago:" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <RadioButton x:Name="rbEfectivo" Content="Efectivo" FontSize="14" Margin="10,5" IsChecked="True" GroupName="MetodoPago"/>
            <RadioButton x:Name="rbTarjeta" Content="Tarjeta de Crédito/Débito" FontSize="14" Margin="10,5" GroupName="MetodoPago"/>
            <RadioButton x:Name="rbTransferencia" Content="Transferencia Bancaria" FontSize="14" Margin="10,5" GroupName="MetodoPago"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Aceptar" Width="100" Margin="5" Click="BtnAceptar_Click" IsDefault="True" Background="#27AE60" Foreground="White" FontWeight="Bold"/>
            <Button Content="Cancelar" Width="100" Margin="5" Click="BtnCancelar_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
