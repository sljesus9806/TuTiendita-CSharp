<Window x:Class="TuTiendita.VentanaConfigHardware"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuracion de Hardware"
        Height="600" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2196F3"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="25">
            <StackPanel>

                <!-- Encabezado -->
                <TextBlock Text="Configuracion de Hardware"
                           FontSize="22" FontWeight="Bold" Foreground="#333"
                           Margin="0,0,0,5"/>
                <TextBlock Text="Configure la bascula, impresoras y otros dispositivos conectados"
                           FontSize="13" Foreground="#666" Margin="0,0,0,25"/>

                <!-- Sección: Báscula -->
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="⚖" FontSize="24" Margin="0,0,10,0"/>
                            <TextBlock Text="Bascula" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Puerto COM" Style="{StaticResource LabelStyle}"/>
                                <ComboBox x:Name="cmbPuertoBascula" Style="{StaticResource ComboStyle}">
                                    <ComboBoxItem Content="(Sin bascula)"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Velocidad (Baud Rate)" Style="{StaticResource LabelStyle}"/>
                                <ComboBox x:Name="cmbBaudRate" Style="{StaticResource ComboStyle}">
                                    <ComboBoxItem Content="1200"/>
                                    <ComboBoxItem Content="2400"/>
                                    <ComboBoxItem Content="4800"/>
                                    <ComboBoxItem Content="9600" IsSelected="True"/>
                                    <ComboBoxItem Content="19200"/>
                                    <ComboBoxItem Content="38400"/>
                                    <ComboBoxItem Content="57600"/>
                                    <ComboBoxItem Content="115200"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Button x:Name="btnProbarBascula" Content="Probar Conexion de Bascula"
                                Background="#3498DB" Foreground="White" BorderThickness="0"
                                Padding="15,10" HorizontalAlignment="Left"
                                Click="btnProbarBascula_Click"/>
                    </StackPanel>
                </Border>

                <!-- Sección: Impresora de Tickets -->
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="🖨" FontSize="24" Margin="0,0,10,0"/>
                            <TextBlock Text="Impresora de Tickets" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="Seleccionar impresora para tickets/recibos" Style="{StaticResource LabelStyle}"/>
                        <ComboBox x:Name="cmbImpresoraTickets" Style="{StaticResource ComboStyle}">
                            <ComboBoxItem Content="(Usar impresora predeterminada)"/>
                        </ComboBox>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Ancho de papel" Style="{StaticResource LabelStyle}"/>
                                <ComboBox x:Name="cmbAnchoTicket" Style="{StaticResource ComboStyle}" Width="120">
                                    <ComboBoxItem Content="58mm"/>
                                    <ComboBoxItem Content="80mm" IsSelected="True"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Impresora de Reportes (opcional)" Style="{StaticResource LabelStyle}"/>
                                <ComboBox x:Name="cmbImpresoraReportes" Style="{StaticResource ComboStyle}">
                                    <ComboBoxItem Content="(Misma que tickets)"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Button x:Name="btnProbarImpresora" Content="Imprimir Prueba"
                                Background="#27AE60" Foreground="White" BorderThickness="0"
                                Padding="15,10" HorizontalAlignment="Left"
                                Click="btnProbarImpresora_Click"/>
                    </StackPanel>
                </Border>

                <!-- Sección: Cajón de Dinero -->
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="💵" FontSize="24" Margin="0,0,10,0"/>
                            <TextBlock Text="Cajon de Dinero" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <CheckBox x:Name="chkCajonConectado" Content="Cajon conectado a impresora de tickets"
                                  IsChecked="True" FontSize="13" Margin="0,0,0,15"/>

                        <Button x:Name="btnAbrirCajon" Content="Probar Apertura de Cajon"
                                Background="#E67E22" Foreground="White" BorderThickness="0"
                                Padding="15,10" HorizontalAlignment="Left"
                                Click="btnAbrirCajon_Click"/>
                    </StackPanel>
                </Border>

                <!-- Sección: Lector de Código de Barras -->
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="📷" FontSize="24" Margin="0,0,10,0"/>
                            <TextBlock Text="Lector de Codigo de Barras" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="Nota: La mayoria de lectores USB funcionan como teclado y no requieren configuracion de puerto COM. Solo configure el puerto si su lector utiliza conexion serial."
                                   TextWrapping="Wrap" FontSize="11" Foreground="#666" Margin="0,0,0,15"/>

                        <TextBlock Text="Puerto COM (opcional)" Style="{StaticResource LabelStyle}"/>
                        <ComboBox x:Name="cmbPuertoLector" Style="{StaticResource ComboStyle}" Width="200" HorizontalAlignment="Left">
                            <ComboBoxItem Content="(Sin puerto - Modo teclado)"/>
                        </ComboBox>

                        <Button x:Name="btnProbarLector" Content="Probar Lector"
                                Background="#9B59B6" Foreground="White" BorderThickness="0"
                                Padding="15,10" HorizontalAlignment="Left"
                                Click="btnProbarLector_Click"/>
                    </StackPanel>
                </Border>

                <!-- Sección: Estado Actual -->
                <Border Background="#E3F2FD" CornerRadius="8" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Estado Actual de Dispositivos" FontWeight="SemiBold"
                                   Foreground="#1565C0" Margin="0,0,0,10"/>
                        <TextBlock x:Name="txtEstadoActual" Text="Cargando..."
                                   Foreground="#333" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Botones -->
        <Border Grid.Row="1" Background="White" Padding="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="-2" Opacity="0.1"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Padding="25,12" FontSize="14"
                        Click="btnCancelar_Click" Margin="0,0,10,0"/>
                <Button Content="Guardar Configuracion"
                        Background="#4CAF50" Foreground="White"
                        Padding="25,12" FontSize="14" FontWeight="SemiBold"
                        BorderThickness="0" Click="btnGuardar_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
