<UserControl x:Class="TuTiendita.DashboardUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="📊 Dashboard" FontSize="28" FontWeight="Bold"/>
                <TextBlock x:Name="txtFechaActual" Text="Hoy, 24 de Noviembre 2025" FontSize="14" Foreground="#7F8C8D" Margin="0,5,0,0"/>
                <Button x:Name="btnActualizar" Content="🔄 Actualizar" Width="120" Height="35"
                        HorizontalAlignment="Left" Margin="0,10,0,0"
                        Background="#3498DB" Foreground="White" FontWeight="Bold" BorderThickness="0"
                        Click="BtnActualizar_Click" Cursor="Hand"/>
            </StackPanel>

            <!-- KPI Cards -->
            <Grid Grid.Row="1" Margin="0,0,0,25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Ventas Hoy -->
                <Border Grid.Column="0" Background="#3498DB" CornerRadius="10" Padding="20" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="💰 Ventas Hoy" FontSize="13" Foreground="White" Opacity="0.9"/>
                        <TextBlock x:Name="txtVentasHoy" Text="$0.00" FontSize="32" FontWeight="Bold" Foreground="White" Margin="0,10,0,5"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="txtVariacionHoy" Text="↑ 12%" FontSize="12" Foreground="#2ECC71" FontWeight="Bold"/>
                            <TextBlock Text=" vs ayer" FontSize="12" Foreground="White" Opacity="0.8" Margin="5,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Ventas Mes -->
                <Border Grid.Column="1" Background="#2ECC71" CornerRadius="10" Padding="20" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="📈 Ventas del Mes" FontSize="13" Foreground="White" Opacity="0.9"/>
                        <TextBlock x:Name="txtVentasMes" Text="$0.00" FontSize="32" FontWeight="Bold" Foreground="White" Margin="0,10,0,5"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="txtVariacionMes" Text="↑ 8%" FontSize="12" Foreground="#F1C40F" FontWeight="Bold"/>
                            <TextBlock Text=" vs mes anterior" FontSize="12" Foreground="White" Opacity="0.8" Margin="5,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Ticket Promedio -->
                <Border Grid.Column="2" Background="#E67E22" CornerRadius="10" Padding="20" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="🎫 Ticket Promedio" FontSize="13" Foreground="White" Opacity="0.9"/>
                        <TextBlock x:Name="txtTicketPromedio" Text="$0.00" FontSize="32" FontWeight="Bold" Foreground="White" Margin="0,10,0,5"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="txtTransaccionesHoy" Text="0" FontSize="12" Foreground="White" FontWeight="Bold"/>
                            <TextBlock Text=" transacciones hoy" FontSize="12" Foreground="White" Opacity="0.8" Margin="5,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Productos Vendidos -->
                <Border Grid.Column="3" Background="#9B59B6" CornerRadius="10" Padding="20">
                    <StackPanel>
                        <TextBlock Text="📦 Productos Vendidos" FontSize="13" Foreground="White" Opacity="0.9"/>
                        <TextBlock x:Name="txtProductosVendidos" Text="0" FontSize="32" FontWeight="Bold" Foreground="White" Margin="0,10,0,5"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="txtStockBajo" Text="0" FontSize="12" Foreground="#E74C3C" FontWeight="Bold"/>
                            <TextBlock Text=" productos bajo stock" FontSize="12" Foreground="White" Opacity="0.8" Margin="5,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Charts Row 1 -->
            <Grid Grid.Row="2" Margin="0,0,0,25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Ventas por Día (últimos 7 días) -->
                <Border Grid.Column="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="📊 Ventas por Día (Últimos 7 días)" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                        <lvc:CartesianChart x:Name="chartVentasPorDia" Height="300"/>
                    </StackPanel>
                </Border>

                <!-- Ventas por Método de Pago -->
                <Border Grid.Column="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="10" Padding="20">
                    <StackPanel>
                        <TextBlock Text="💳 Métodos de Pago" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                        <lvc:PieChart x:Name="chartMetodosPago" Height="300"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Charts Row 2 -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Productos Más Vendidos -->
                <Border Grid.Column="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="🏆 Top 5 Productos Más Vendidos" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                        <lvc:CartesianChart x:Name="chartProductosTop" Height="300"/>
                    </StackPanel>
                </Border>

                <!-- Ventas por Hora del Día -->
                <Border Grid.Column="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="10" Padding="20">
                    <StackPanel>
                        <TextBlock Text="⏰ Ventas por Hora (Hoy)" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                        <lvc:CartesianChart x:Name="chartVentasPorHora" Height="300"/>
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>
    </ScrollViewer>
</UserControl>
