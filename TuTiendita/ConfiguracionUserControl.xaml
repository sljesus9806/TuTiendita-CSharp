<UserControl x:Class="TuTiendita.ConfiguracionUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Título -->
            <TextBlock Grid.Row="0" Text="⚙️ Configuración del Sistema"
                      FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

            <!-- Tabs de configuración -->
            <TabControl Grid.Row="1">

                <!-- Tab: Información de la Tienda -->
                <TabItem Header="🏪 Información de la Tienda">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20">
                            <TextBlock Text="Datos de la Tienda" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

                            <TextBlock Text="Nombre de la Tienda:" Margin="0,5,0,3"/>
                            <TextBox x:Name="txtNombreTienda" Padding="8" FontSize="14"/>

                            <TextBlock Text="RUC / NIT:" Margin="0,10,0,3"/>
                            <TextBox x:Name="txtRUC" Padding="8" FontSize="14"/>

                            <TextBlock Text="Dirección:" Margin="0,10,0,3"/>
                            <TextBox x:Name="txtDireccion" Padding="8" FontSize="14" Height="60"
                                    TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

                            <TextBlock Text="Teléfono:" Margin="0,10,0,3"/>
                            <TextBox x:Name="txtTelefono" Padding="8" FontSize="14"/>

                            <TextBlock Text="Email:" Margin="0,10,0,3"/>
                            <TextBox x:Name="txtEmail" Padding="8" FontSize="14"/>

                            <TextBlock Text="IVA / Impuesto (%):" Margin="0,10,0,3"/>
                            <TextBox x:Name="txtIVA" Padding="8" FontSize="14" Text="0"/>

                            <TextBlock Text="Símbolo de Moneda:" Margin="0,10,0,3"/>
                            <TextBox x:Name="txtMonedaSimbolo" Padding="8" FontSize="14" Text="$" MaxLength="3"/>

                            <TextBlock Text="Mensaje de Pie de Página (Tickets):" Margin="0,10,0,3"/>
                            <TextBox x:Name="txtMensajePie" Padding="8" FontSize="14" Height="60"
                                    TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

                            <Button Content="💾 Guardar Configuración"
                                   Width="200" Height="40" Margin="0,20,0,0"
                                   Background="#27AE60" Foreground="White" FontWeight="Bold" FontSize="14"
                                   Click="BtnGuardarConfiguracion_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Tab: Backup y Restauración -->
                <TabItem Header="💾 Backup y Restauración">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20">
                            <TextBlock Text="Gestión de Backups" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

                            <!-- Configuración de backup automático -->
                            <Border BorderBrush="#3498DB" BorderThickness="2" Padding="15" Margin="0,0,0,20" CornerRadius="5">
                                <StackPanel>
                                    <TextBlock Text="Backup Automático" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                                    <CheckBox x:Name="chkBackupAutomatico" Content="Activar backup automático"
                                             FontSize="13" Margin="0,5,0,10"/>

                                    <TextBlock Text="Intervalo de backup (horas):" Margin="0,5,0,3"/>
                                    <ComboBox x:Name="cmbIntervaloBackup" SelectedIndex="0" Padding="8" FontSize="13">
                                        <ComboBoxItem Content="6 horas"/>
                                        <ComboBoxItem Content="12 horas"/>
                                        <ComboBoxItem Content="24 horas (recomendado)"/>
                                        <ComboBoxItem Content="48 horas"/>
                                        <ComboBoxItem Content="72 horas"/>
                                    </ComboBox>

                                    <Button Content="💾 Guardar Configuración de Backup"
                                           Width="Auto" Height="35" Margin="0,15,0,0"
                                           Background="#3498DB" Foreground="White" FontWeight="Bold"
                                           Click="BtnGuardarConfigBackup_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- Backup manual -->
                            <Border BorderBrush="#27AE60" BorderThickness="2" Padding="15" Margin="0,0,0,20" CornerRadius="5">
                                <StackPanel>
                                    <TextBlock Text="Backup Manual" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                                    <TextBlock Text="Crea una copia de seguridad completa de todos los datos del sistema."
                                              TextWrapping="Wrap" Margin="0,0,0,10" Foreground="#555"/>

                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="btnCrearBackup" Content="📦 Crear Backup Ahora"
                                               Width="180" Height="40" Margin="0,0,10,0"
                                               Background="#27AE60" Foreground="White" FontWeight="Bold"
                                               Click="BtnCrearBackup_Click"/>

                                        <Button Content="📁 Abrir Carpeta de Backups"
                                               Width="200" Height="40"
                                               Background="#95A5A6" Foreground="White" FontWeight="Bold"
                                               Click="BtnAbrirCarpetaBackups_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Lista de backups -->
                            <TextBlock Text="Backups Disponibles" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                            <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="5" Padding="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="250"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <DataGrid x:Name="dgBackups" Grid.Row="1"
                                             AutoGenerateColumns="False" IsReadOnly="True"
                                             SelectionMode="Single" CanUserAddRows="False"
                                             HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                             AlternatingRowBackground="#F8F9FA">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                                            <DataGridTextColumn Header="Fecha" Binding="{Binding FechaFormateada}" Width="150"/>
                                            <DataGridTextColumn Header="Tamaño" Binding="{Binding TamanoFormateado}" Width="100"/>
                                            <DataGridTextColumn Header="Tipo" Binding="{Binding TipoBackup}" Width="100"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="10" HorizontalAlignment="Right">
                                        <Button Content="🔄 Actualizar Lista"
                                               Width="140" Height="35" Margin="0,0,10,0"
                                               Background="#3498DB" Foreground="White" FontWeight="Bold"
                                               Click="BtnActualizarBackups_Click"/>

                                        <Button x:Name="btnRestaurar" Content="⚠️ Restaurar Backup"
                                               Width="160" Height="35"
                                               Background="#E74C3C" Foreground="White" FontWeight="Bold"
                                               Click="BtnRestaurarBackup_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Tab: Seguridad -->
                <TabItem Header="🔐 Seguridad">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20">
                            <TextBlock Text="Cambiar Contraseña" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

                            <Border BorderBrush="#E74C3C" BorderThickness="2" Padding="15" CornerRadius="5">
                                <StackPanel>
                                    <TextBlock Text="⚠️ Solo puedes cambiar tu propia contraseña"
                                              Foreground="#E74C3C" FontWeight="Bold" Margin="0,0,0,15"/>

                                    <TextBlock Text="Usuario Actual:" Margin="0,5,0,3"/>
                                    <TextBlock x:Name="txtUsuarioActual" Text="[Usuario]" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                                    <TextBlock Text="Contraseña Actual:" Margin="0,10,0,3"/>
                                    <PasswordBox x:Name="txtPasswordActual" Padding="8" FontSize="14"/>

                                    <TextBlock Text="Nueva Contraseña:" Margin="0,10,0,3"/>
                                    <PasswordBox x:Name="txtPasswordNueva" Padding="8" FontSize="14"/>

                                    <TextBlock Text="Confirmar Nueva Contraseña:" Margin="0,10,0,3"/>
                                    <PasswordBox x:Name="txtPasswordConfirmar" Padding="8" FontSize="14"/>

                                    <TextBlock Text="Requisitos: Mínimo 6 caracteres"
                                              Foreground="#7F8C8D" FontSize="11" Margin="0,5,0,15"/>

                                    <Button Content="🔒 Cambiar Contraseña"
                                           Width="200" Height="40"
                                           Background="#E74C3C" Foreground="White" FontWeight="Bold" FontSize="14"
                                           Click="BtnCambiarPassword_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- Auditoría -->
                            <TextBlock Text="Registro de Auditoría" FontSize="16" FontWeight="Bold" Margin="0,30,0,15"/>
                            <Border BorderBrush="#3498DB" BorderThickness="2" Padding="15" CornerRadius="5">
                                <StackPanel>
                                    <TextBlock Text="El sistema registra automáticamente todas las acciones importantes:"
                                              TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <TextBlock Text="• Login y logout de usuarios" Margin="5,3"/>
                                    <TextBlock Text="• Ventas realizadas" Margin="5,3"/>
                                    <TextBlock Text="• Apertura y cierre de turnos" Margin="5,3"/>
                                    <TextBlock Text="• Cambios en productos" Margin="5,3"/>
                                    <TextBlock Text="• Movimientos de caja" Margin="5,3"/>
                                    <TextBlock Text="• Cambios de configuración" Margin="5,3"/>
                                    <TextBlock Text="• Backups y restauraciones" Margin="5,3"/>

                                    <TextBlock Text="📊 Los registros se almacenan de forma permanente en la base de datos."
                                              Foreground="#27AE60" FontWeight="Bold" Margin="0,15,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Tab: Acerca de -->
                <TabItem Header="ℹ️ Acerca de">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20" HorizontalAlignment="Center">
                            <TextBlock Text="TuTiendita POS" FontSize="28" FontWeight="Bold"
                                      HorizontalAlignment="Center" Margin="0,20,0,10"/>
                            <TextBlock Text="Sistema de Punto de Venta" FontSize="16"
                                      HorizontalAlignment="Center" Foreground="#7F8C8D" Margin="0,0,0,30"/>

                            <Border BorderBrush="#3498DB" BorderThickness="2" Padding="20" CornerRadius="10" Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="Versión 2.0" FontSize="14" FontWeight="Bold" Margin="0,0,0,15"/>

                                    <TextBlock Text="✨ Características Principales:" FontWeight="Bold" Margin="0,10,0,10"/>
                                    <TextBlock Text="• Gestión completa de ventas y productos" Margin="5,3"/>
                                    <TextBlock Text="• Sistema de turnos y cierre de caja" Margin="5,3"/>
                                    <TextBlock Text="• Control de usuarios por roles" Margin="5,3"/>
                                    <TextBlock Text="• Tickets y reportes en PDF" Margin="5,3"/>
                                    <TextBlock Text="• Backup automático y manual" Margin="5,3"/>
                                    <TextBlock Text="• Registro de auditoría completo" Margin="5,3"/>
                                    <TextBlock Text="• Seguridad con encriptación BCrypt" Margin="5,3"/>
                                    <TextBlock Text="• Cálculo automático de impuestos" Margin="5,3"/>

                                    <TextBlock Text="🔒 Seguridad:" FontWeight="Bold" Margin="0,15,0,10"/>
                                    <TextBlock Text="• Contraseñas encriptadas con BCrypt" Margin="5,3"/>
                                    <TextBlock Text="• Auditoría de todas las acciones" Margin="5,3"/>
                                    <TextBlock Text="• Control de permisos por rol" Margin="5,3"/>

                                    <TextBlock Text="💾 Base de Datos:" FontWeight="Bold" Margin="0,15,0,10"/>
                                    <TextBlock Text="• SQLite 3 con integridad referencial" Margin="5,3"/>
                                    <TextBlock Text="• Backup automático programable" Margin="5,3"/>
                                    <TextBlock Text="• Restauración con seguridad" Margin="5,3"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="© 2024 TuTiendita. Todos los derechos reservados."
                                      HorizontalAlignment="Center" Foreground="#95A5A6" FontSize="12"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

            </TabControl>
        </Grid>
    </ScrollViewer>
</UserControl>
