<Window x:Class="TuTiendita.VentanaPrincipal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TuTiendita"
        mc:Ignorable="d"
        Title="VentanaPrincipal" MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen">
    <!-- Eliminado SizeToContent -->
    <Grid>
        <!-- Definición de Columnas -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <!-- Sidebar -->
            <ColumnDefinition Width="*"/>
            <!-- Área Principal -->
        </Grid.ColumnDefinitions>

        <!-- Definición de Filas -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Ribbon o Barra de Herramientas Superior -->
            <RowDefinition Height="*"/>
            <!-- Contenido Principal -->
        </Grid.RowDefinitions>

        <!-- Barra Superior con Info de Usuario -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#2C3E50" Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="👤 Usuario:" Foreground="White" FontWeight="SemiBold" Margin="0,0,10,0" FontSize="14"/>
                    <TextBlock x:Name="txtUsuarioActual" Text="" Foreground="#ECF0F1" FontSize="14" Margin="0,0,15,0"/>
                    <TextBlock Text="•" Foreground="#BDC3C7" Margin="0,0,10,0" FontSize="14"/>
                    <TextBlock Text="Rol:" Foreground="White" FontWeight="SemiBold" Margin="0,0,10,0" FontSize="14"/>
                    <TextBlock x:Name="txtRolActual" Text="" Foreground="#3498DB" FontWeight="Bold" FontSize="14"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="btnCambiarUsuario" Content="🔐 Cambiar Usuario (Admin)" Width="200" Height="35"
                            Background="#E67E22" Foreground="White" FontWeight="Bold" BorderThickness="0"
                            Click="BtnCambiarUsuario_Click" Cursor="Hand" Margin="0,0,10,0"/>
                    <Button Content="🚪 Cerrar Sesión" Width="140" Height="35"
                            Background="#E74C3C" Foreground="White" FontWeight="Bold" BorderThickness="0"
                            Click="BtnCerrarSesion_Click" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Sidebar (Menú de Navegación) -->
        <StackPanel Grid.Row="1" Grid.Column="0" Background="#EDEDED" VerticalAlignment="Stretch">
            <Button Content="📊 Dashboard" Margin="5" HorizontalAlignment="Stretch" Click="Dashboard_Click"
                    Background="#3498DB" Foreground="White" FontWeight="Bold"/>
            <Button Content="Ventas" Margin="5" HorizontalAlignment="Stretch" Click="Ventas_Click"/>
            <Button Content="Gestión de Turno" Margin="5" HorizontalAlignment="Stretch" Click="CerrarCaja_Click"/>
            <Button Content="Reportes" Margin="5" HorizontalAlignment="Stretch" Click="Reportes_Click"/>
            <Button Content="Productos" Margin="5" HorizontalAlignment="Stretch" Click="Productos_Click"/>
            <Button x:Name="Compras" Content="Compras" Margin="5" HorizontalAlignment="Stretch" Click="Compras_Click"/>
            <Button x:Name="Clientes" Content="Clientes" Margin="5" HorizontalAlignment="Stretch" Click="Clientes_Click"/>
            <Button x:Name="Usuarios" Content="Usuarios" Margin="5" HorizontalAlignment="Stretch" Click="Usuarios_Click"/>
            <Button x:Name="Configuracion" Content="Configuración" Margin="5" HorizontalAlignment="Stretch" Click="Configuracion_Click"/>
        </StackPanel>

        <!-- Área Principal -->
        <ContentControl x:Name="MainContent" Grid.Row="1" Grid.Column="1" Background="White"/>
    </Grid>
</Window>