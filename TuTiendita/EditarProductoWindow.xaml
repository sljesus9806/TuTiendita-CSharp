<Window x:Class="TuTiendita.EditarProductoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar Producto" Height="420" Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5">
    <Grid>
        <!-- Header -->
        <Border Background="#E67E22" Height="60" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="28" VerticalAlignment="Center" Foreground="White" Margin="0,0,10,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Editar Producto" FontSize="20" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Modifique los datos del producto" FontSize="12" Foreground="#FAD7A0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Form Content -->
        <Border Margin="20,80,20,20" Background="White" CornerRadius="8"
                BorderBrush="#E0E0E0" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
            </Border.Effect>
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Codigo (solo lectura) -->
                <StackPanel Grid.Row="0" Margin="0,0,0,15">
                    <TextBlock Text="Codigo" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtCodigo" Height="38" FontSize="14" Padding="10,8"
                             BorderBrush="#DDD" BorderThickness="1" IsReadOnly="True"
                             Background="#F5F5F5" Foreground="#666"/>
                </StackPanel>

                <!-- Nombre del Producto -->
                <StackPanel Grid.Row="1" Margin="0,0,0,15">
                    <TextBlock Text="Nombre del Producto *" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtNombre" Height="38" FontSize="14" Padding="10,8"
                             BorderBrush="#DDD" BorderThickness="1"/>
                </StackPanel>

                <!-- Precio y Stock -->
                <Grid Grid.Row="2" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Precio de Venta *" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,5"/>
                        <Grid>
                            <TextBox x:Name="txtPrecio" Height="38" FontSize="14" Padding="35,8,10,8"
                                     BorderBrush="#DDD" BorderThickness="1"/>
                            <TextBlock Text="$" FontSize="14" FontWeight="Bold" Foreground="#666"
                                       VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Stock *" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtStock" Height="38" FontSize="14" Padding="10,8"
                                 BorderBrush="#DDD" BorderThickness="1"/>
                    </StackPanel>
                </Grid>

                <!-- Info de cambios -->
                <Border Grid.Row="3" Background="#FEF9E7" CornerRadius="5" Padding="10" Margin="0,0,0,15">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#F39C12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="txtInfoCambios" Text="Los cambios se guardaran al presionar 'Guardar'" FontSize="11" Foreground="#7D6608" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Botones -->
                <Grid Grid.Row="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="1" Content="Cancelar" Width="100" Height="40" Margin="0,0,10,0"
                            Click="BtnCancelar_Click" Background="#E0E0E0" Foreground="#333"
                            BorderThickness="0" FontSize="14" Cursor="Hand"/>
                    <Button Grid.Column="2" Content="Guardar" Width="120" Height="40"
                            Click="BtnGuardar_Click" Background="#E67E22" Foreground="White"
                            FontWeight="Bold" BorderThickness="0" FontSize="14" Cursor="Hand"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
