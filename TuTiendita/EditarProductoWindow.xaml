<Window x:Class="TuTiendita.EditarProductoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar Producto"
        MinHeight="450" MinWidth="420"
        SizeToContent="Height" Width="480"
        MaxHeight="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#F5F5F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#E67E22" Padding="20,15">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="EDITAR PRODUCTO" FontSize="20" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="Modifique los datos del producto" FontSize="12"
                           Foreground="#FAD7A0" HorizontalAlignment="Center" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Content con ScrollViewer -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="25,20,25,25">
                <!-- Código (solo lectura) -->
                <TextBlock Text="CODIGO" FontSize="12" FontWeight="Bold"
                           Foreground="#666" Margin="0,0,0,8"/>
                <Border Background="#ECF0F1" CornerRadius="6" BorderBrush="#BDC3C7"
                        BorderThickness="1" Margin="0,0,0,15">
                    <TextBox x:Name="txtCodigo" Height="42" FontSize="14" Padding="12,0"
                             BorderThickness="0" Background="Transparent" IsReadOnly="True"
                             Foreground="#7F8C8D" VerticalContentAlignment="Center"/>
                </Border>

                <!-- Nombre del Producto -->
                <TextBlock Text="NOMBRE DEL PRODUCTO *" FontSize="12" FontWeight="Bold"
                           Foreground="#666" Margin="0,0,0,8"/>
                <Border Background="White" CornerRadius="6" BorderBrush="#DDD"
                        BorderThickness="1" Margin="0,0,0,15">
                    <TextBox x:Name="txtNombre" Height="42" FontSize="14" Padding="12,0"
                             BorderThickness="0" Background="Transparent"
                             VerticalContentAlignment="Center"/>
                </Border>

                <!-- Precio y Stock -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="PRECIO DE VENTA *" FontSize="12" FontWeight="Bold"
                                   Foreground="#666" Margin="0,0,0,8"/>
                        <Border Background="White" CornerRadius="6" BorderBrush="#E67E22"
                                BorderThickness="2">
                            <Grid>
                                <TextBox x:Name="txtPrecio" Height="42" FontSize="16" FontWeight="SemiBold"
                                         Padding="35,0,12,0" BorderThickness="0" Background="Transparent"
                                         VerticalContentAlignment="Center"/>
                                <TextBlock Text="$" FontSize="16" FontWeight="Bold" Foreground="#E67E22"
                                           VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="STOCK *" FontSize="12" FontWeight="Bold"
                                   Foreground="#666" Margin="0,0,0,8"/>
                        <Border Background="White" CornerRadius="6" BorderBrush="#DDD"
                                BorderThickness="1">
                            <TextBox x:Name="txtStock" Height="42" FontSize="14" Padding="12,0"
                                     BorderThickness="0" Background="Transparent"
                                     VerticalContentAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Info de cambios -->
                <Border Background="#FEF9E7" CornerRadius="8" Padding="12" Margin="0,0,0,20"
                        BorderBrush="#F39C12" BorderThickness="1">
                    <TextBlock x:Name="txtInfoCambios"
                               Text="Los cambios se guardaran al presionar 'Guardar'"
                               TextWrapping="Wrap" FontSize="12" Foreground="#7D6608"
                               HorizontalAlignment="Center"/>
                </Border>

                <!-- Botones -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="Cancelar" Height="48" Margin="0,0,5,0"
                            Click="BtnCancelar_Click" Background="#E0E0E0" Foreground="#333"
                            BorderThickness="0" FontSize="15" Cursor="Hand" IsCancel="True">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Grid.Column="1" Content="Guardar Cambios" Height="48" Margin="5,0,0,0"
                            Click="BtnGuardar_Click" Background="#E67E22" Foreground="White"
                            FontWeight="Bold" BorderThickness="0" FontSize="15" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
