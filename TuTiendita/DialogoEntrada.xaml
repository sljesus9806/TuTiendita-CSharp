<Window x:Class="TuTiendita.DialogoEntrada"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Entrada de Datos"
        MinHeight="200" MinWidth="400"
        SizeToContent="Height" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#E74C3C" Padding="20,15">
            <StackPanel>
                <TextBlock x:Name="txtTitulo" Text="Cancelar Venta"
                           FontSize="18" FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="txtSubtitulo" Text="Ingrese la información requerida"
                           FontSize="12" Foreground="#FADBD8" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Pregunta -->
            <TextBlock x:Name="lblQuestion" Grid.Row="0"
                       TextWrapping="Wrap" FontSize="14"
                       Foreground="#333" Margin="0,0,0,10"/>

            <!-- Campo de entrada -->
            <Border Grid.Row="1" Background="White" CornerRadius="6"
                    BorderBrush="#DDD" BorderThickness="1" Margin="0,0,0,20">
                <TextBox x:Name="txtAnswer"
                         FontSize="14" Padding="12,10"
                         BorderThickness="0" Background="Transparent"
                         AcceptsReturn="False"
                         VerticalContentAlignment="Center"/>
            </Border>

            <!-- Botones -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Cancelar"
                        Height="40" Margin="0,0,5,0"
                        Click="BtnCancel_Click"
                        Background="#E0E0E0" Foreground="#333"
                        BorderThickness="0" FontSize="14"
                        Cursor="Hand" IsCancel="True">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="6" Padding="15,10">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Grid.Column="1" x:Name="btnAceptar" Content="Aceptar"
                        Height="40" Margin="5,0,0,0"
                        Click="BtnOK_Click"
                        Background="#E74C3C" Foreground="White"
                        FontWeight="Bold" BorderThickness="0"
                        FontSize="14" Cursor="Hand" IsDefault="True">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="6" Padding="15,10">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Window>
